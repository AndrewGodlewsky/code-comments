# Local environment configuration; track examples for onboarding.
.env
.env.*
!.env.example
!.env.*.example

# Operating system metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Derived and bulk eval output; commit _state.json and results.jsonl deliberately.
.claude/hillclimb/**/traces/
.claude/hillclimb/**/report.html
.claude/hillclimb/**/trajectory/

# Local Python bytecode from offline evaluation tools.
__pycache__/
*.py[cod]

# Bulk pilot output (#43). Commit run.json, results.jsonl, summary.json, diffs/,
# reviews/ and lanes/ deliberately; the raw session traces are archived separately.
evaluation/pilot/runs/**/junit/
evaluation/pilot/runs/**/pytest/
evaluation/pilot/runs/**/sessions/
evaluation/pilot/runs/**/plugin/
