{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env.pilot)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(gc *.env*)"
    ]
  }
}
