 -- Nightly load of the CSV that exporter/csv_out.py writes.
 -- warehouse-load stages each file as export_staging(c1, c2, ...): fields are
 -- numbered by position, and the header row is skipped, not read. The order of
--- COLUMNS in exporter/csv_out.py is therefore part of this contract: new export
--- columns go at the end, or every field after the new one loads into the wrong
--- column here.
-INSERT INTO ledger_raw (entry_id, account_code, amount, posted_at)
-SELECT c1, c2, c3, c4
+-- COLUMNS in exporter/csv_out.py is therefore part of this contract: when that
+-- order changes, update the c-numbers below in the same change.
+-- Current order: c1 id, c2 account, c3 amount, c4 currency, c5 ts.
+-- ledger_raw.currency is the last table column (see schema.sql), so it is
+-- listed last here and fed from c4.
+INSERT INTO ledger_raw (entry_id, account_code, amount, posted_at, currency)
+SELECT c1, c2, c3, c5, c4
 FROM export_staging;
