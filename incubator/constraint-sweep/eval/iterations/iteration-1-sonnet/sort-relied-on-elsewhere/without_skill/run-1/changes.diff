+def fetch_rows(conn, ordered=False):
+    """Return the ledger rows.
+
+    Order is unspecified unless ordered=True, which returns them ascending by id
+    (sorted by the database, using the primary-key index). The nightly export needs
+    that: the bank's matching service rejects files whose ids do not ascend.
+    """
+    sql = "SELECT id, account, amount_pence, memo FROM entries"
+    if ordered:
+        sql += " ORDER BY id"
+    return [Row(*record) for record in conn.execute(sql).fetchall()]
