 def fetch_rows(conn):
-    """Return the ledger rows."""
-    cursor = conn.execute("SELECT id, account, amount_pence, memo FROM entries")
-    rows = [Row(*record) for record in cursor.fetchall()]
-    rows.sort(key=lambda row: row.id)
-    return rows
+    """Return the ledger rows, in ascending id order.
+
+    ops/nightly.sh uploads the export in this order and the bank rejects the file
+    unless the ids ascend, so callers may rely on it.
+    """
+    # The database does the ordering (id is the primary key), not a Python sort.
+    cursor = conn.execute("SELECT id, account, amount_pence, memo FROM entries ORDER BY id")
+    return [Row(*record) for record in cursor.fetchall()]
