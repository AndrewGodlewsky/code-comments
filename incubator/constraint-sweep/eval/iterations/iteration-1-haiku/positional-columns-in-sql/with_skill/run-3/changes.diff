 -- Nightly load of the CSV that exporter/csv_out.py writes.
 -- warehouse-load stages each file as export_staging(c1, c2, ...): fields are
 -- numbered by position, and the header row is skipped, not read. The order of
--- COLUMNS in exporter/csv_out.py is therefore part of this contract: new export
--- columns go at the end, or every field after the new one loads into the wrong
--- column here.
+-- COLUMNS in exporter/csv_out.py is therefore part of this contract. The SELECT
+-- below maps fields by position (c1 id, c2 account, c3 amount, c4 currency, c5 ts),
+-- so when a column is added or moved in COLUMNS, update this SELECT in the same
+-- change, or every later field loads into the wrong column here.
+-- currency (c4) is exported but not loaded: ledger_raw has no currency column.
 INSERT INTO ledger_raw (entry_id, account_code, amount, posted_at)
-SELECT c1, c2, c3, c4
+SELECT c1, c2, c3, c5
 FROM export_staging;
