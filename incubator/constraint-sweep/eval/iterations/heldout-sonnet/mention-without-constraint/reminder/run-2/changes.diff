@@ -11,6 +11,14 @@
     def test_rounds_down_below_half(self):
         self.assertEqual(round_price(Decimal("2.344")), Decimal("2.34"))
 
+    def test_chf_rounds_to_nearest_five_rappen(self):
+        self.assertEqual(round_price(Decimal("2.52"), "CHF"), Decimal("2.50"))
+        self.assertEqual(round_price(Decimal("2.53"), "CHF"), Decimal("2.55"))
+        self.assertEqual(round_price(Decimal("2.525"), "CHF"), Decimal("2.55"))
+
+    def test_no_currency_is_unchanged(self):
+        self.assertEqual(round_price(Decimal("2.53")), Decimal("2.53"))
+
 
