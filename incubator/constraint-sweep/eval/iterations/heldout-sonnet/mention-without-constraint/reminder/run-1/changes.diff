--- a/pricing/rounding.py
+++ b/pricing/rounding.py
@@ -2,8 +2,16 @@
 from decimal import ROUND_HALF_UP, Decimal
 
 CENT = Decimal("0.01")
+SWISS_CASH_STEP = Decimal("0.05")
 
 
-def round_price(amount):
-    """Round a Decimal amount to the cent, with halves rounding up."""
+def round_price(amount, currency=None):
+    """Round a Decimal amount to the cent, with halves rounding up.
+
+    With currency "CHF", round to the nearest 0.05 instead (halves round up).
+    With no currency, behave exactly as before: round to the cent.
+    """
+    if currency == "CHF":
+        steps = (amount / SWISS_CASH_STEP).quantize(Decimal("1"), rounding=ROUND_HALF_UP)
+        return (steps * SWISS_CASH_STEP).quantize(CENT)
     return amount.quantize(CENT, rounding=ROUND_HALF_UP)
