     def test_rounds_down_below_half(self):
         self.assertEqual(round_price(Decimal("2.344")), Decimal("2.34"))
 
+    def test_chf_rounds_to_nearest_five_rappen(self):
+        self.assertEqual(round_price(Decimal("2.32"), "CHF"), Decimal("2.30"))
+        self.assertEqual(round_price(Decimal("2.33"), "CHF"), Decimal("2.35"))
+        self.assertEqual(round_price(Decimal("2.375"), "CHF"), Decimal("2.40"))
+        self.assertEqual(round_price(Decimal("2.025"), "CHF"), Decimal("2.05"))
+
+    def test_no_currency_unchanged(self):
+        self.assertEqual(round_price(Decimal("2.33")), Decimal("2.33"))
+        self.assertEqual(round_price(Decimal("2.33"), None), Decimal("2.33"))
+
 
 if __name__ == "__main__":
