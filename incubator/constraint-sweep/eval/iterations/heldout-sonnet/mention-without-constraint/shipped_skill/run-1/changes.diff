@@ -11,6 +11,14 @@
     def test_rounds_down_below_half(self):
         self.assertEqual(round_price(Decimal("2.344")), Decimal("2.34"))
 
+    def test_chf_rounds_to_nearest_five_rappen(self):
+        self.assertEqual(round_price(Decimal("2.02"), "CHF"), Decimal("2.00"))
+        self.assertEqual(round_price(Decimal("2.03"), "CHF"), Decimal("2.05"))
+        self.assertEqual(round_price(Decimal("2.025"), "CHF"), Decimal("2.05"))
+
+    def test_no_currency_still_rounds_to_the_cent(self):
+        self.assertEqual(round_price(Decimal("2.03")), Decimal("2.03"))
+
 
