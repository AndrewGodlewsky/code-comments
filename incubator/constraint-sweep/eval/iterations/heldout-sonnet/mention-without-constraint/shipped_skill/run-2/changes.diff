--- a/pricing/rounding.py
+++ b/pricing/rounding.py
@@ -3,7 +3,18 @@
 
 CENT = Decimal("0.01")
 
+# Swiss cash prices round to the nearest 0.05 CHF.
+CASH_INCREMENTS = {"CHF": Decimal("0.05")}
 
-def round_price(amount):
-    """Round a Decimal amount to the cent, with halves rounding up."""
-    return amount.quantize(CENT, rounding=ROUND_HALF_UP)
+
+def round_price(amount, currency=None):
+    """Round a Decimal amount, with halves rounding up.
+
+    With no currency, or one not in CASH_INCREMENTS, round to the cent. "CHF" rounds
+    to the nearest 0.05.
+    """
+    increment = CASH_INCREMENTS.get(currency)
+    if increment is None:
+        return amount.quantize(CENT, rounding=ROUND_HALF_UP)
+    steps = (amount / increment).quantize(Decimal("1"), rounding=ROUND_HALF_UP)
+    return (steps * increment).quantize(CENT)
