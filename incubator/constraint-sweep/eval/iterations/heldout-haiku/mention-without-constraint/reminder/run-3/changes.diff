+++ b/tests/test_rounding.py
@@ -11,6 +11,21 @@
     def test_rounds_down_below_half(self):
         self.assertEqual(round_price(Decimal("2.344")), Decimal("2.34"))
 
+    def test_no_currency_rounds_to_the_cent(self):
+        self.assertEqual(round_price(Decimal("2.337")), Decimal("2.34"))
+
+    def test_chf_rounds_to_nearest_five_rappen(self):
+        self.assertEqual(round_price(Decimal("2.37"), "CHF"), Decimal("2.35"))
+        self.assertEqual(round_price(Decimal("2.38"), "CHF"), Decimal("2.40"))
+
+    def test_chf_halves_round_up(self):
+        self.assertEqual(round_price(Decimal("2.325"), "CHF"), Decimal("2.35"))
+        self.assertEqual(round_price(Decimal("2.345"), "CHF"), Decimal("2.35"))
+
+    def test_chf_exact_steps_are_unchanged(self):
+        self.assertEqual(round_price(Decimal("10.00"), "CHF"), Decimal("10.00"))
+        self.assertEqual(round_price(Decimal("10.05"), "CHF"), Decimal("10.05"))
+
 
 if __name__ == "__main__":
     unittest.main()
