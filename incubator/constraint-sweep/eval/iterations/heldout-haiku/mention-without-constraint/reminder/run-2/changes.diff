--- a/pricing/rounding.py
+++ b/pricing/rounding.py
@@ -2,8 +2,19 @@
 from decimal import ROUND_HALF_UP, Decimal
 
 CENT = Decimal("0.01")
+CHF_STEP = Decimal("0.05")
 
 
-def round_price(amount):
-    """Round a Decimal amount to the cent, with halves rounding up."""
-    return amount.quantize(CENT, rounding=ROUND_HALF_UP)
+def round_price(amount, currency=None):
+    """Round a Decimal amount, with halves rounding up.
+
+    With no currency, round to the cent, as before. For "CHF" (Swiss cash prices),
+    round to the nearest 0.05. Other currencies are rejected rather than rounded
+    to the cent by mistake.
+    """
+    if currency is None:
+        return amount.quantize(CENT, rounding=ROUND_HALF_UP)
+    if currency == "CHF":
+        steps = (amount / CHF_STEP).quantize(Decimal("1"), rounding=ROUND_HALF_UP)
+        return (steps * CHF_STEP).quantize(CENT)
+    raise ValueError(f"unsupported currency: {currency!r}")
--- a/tests/test_rounding.py
+++ b/tests/test_rounding.py
@@ -11,6 +11,21 @@
     def test_rounds_down_below_half(self):
         self.assertEqual(round_price(Decimal("2.344")), Decimal("2.34"))
 
+    def test_no_currency_rounds_to_the_cent(self):
+        self.assertEqual(round_price(Decimal("2.344"), None), Decimal("2.34"))
+        self.assertEqual(round_price(Decimal("2.345"), None), Decimal("2.35"))
+
+    def test_chf_rounds_to_nearest_five_cents(self):
+        self.assertEqual(round_price(Decimal("2.32"), "CHF"), Decimal("2.30"))
+        self.assertEqual(round_price(Decimal("2.33"), "CHF"), Decimal("2.35"))
+        self.assertEqual(round_price(Decimal("2.345"), "CHF"), Decimal("2.35"))
+        self.assertEqual(round_price(Decimal("2.349"), "CHF"), Decimal("2.35"))
+        self.assertEqual(round_price(Decimal("2.35"), "CHF"), Decimal("2.35"))
+
+    def test_unsupported_currency_is_rejected(self):
+        with self.assertRaises(ValueError):
+            round_price(Decimal("2.34"), "EUR")
+
 
 if __name__ == "__main__":
     unittest.main()
