@@ -2,8 +2,16 @@
 from decimal import ROUND_HALF_UP, Decimal
 
 CENT = Decimal("0.01")
+# Swiss cash prices are rounded to the nearest 0.05 CHF.
+CHF_CASH_STEP = Decimal("0.05")
 
 
-def round_price(amount):
-    """Round a Decimal amount to the cent, with halves rounding up."""
+def round_price(amount, currency=None):
+    """Round a Decimal amount to the cent, with halves rounding up.
+
+    For "CHF" the amount rounds to the nearest 0.05 instead.
+    """
+    if currency == "CHF":
+        steps = (amount / CHF_CASH_STEP).quantize(Decimal("1"), rounding=ROUND_HALF_UP)
+        return steps * CHF_CASH_STEP
     return amount.quantize(CENT, rounding=ROUND_HALF_UP)
