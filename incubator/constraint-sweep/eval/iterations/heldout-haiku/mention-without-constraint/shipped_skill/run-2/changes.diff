--- a/pricing/rounding.py
+++ b/pricing/rounding.py
@@ -2,8 +2,17 @@
 from decimal import ROUND_HALF_UP, Decimal
 
 CENT = Decimal("0.01")
+# Swiss cash prices are rounded to the nearest 0.05 CHF.
+CHF_CASH_STEP = Decimal("0.05")
 
 
-def round_price(amount):
-    """Round a Decimal amount to the cent, with halves rounding up."""
+def round_price(amount, currency=None):
+    """Round a Decimal amount, with halves rounding up.
+
+    Without a currency the amount rounds to the cent. For "CHF" it rounds to the
+    nearest CHF_CASH_STEP, the Swiss cash rounding rule.
+    """
+    if currency == "CHF":
+        steps = (amount / CHF_CASH_STEP).quantize(Decimal("1"), rounding=ROUND_HALF_UP)
+        return steps * CHF_CASH_STEP
     return amount.quantize(CENT, rounding=ROUND_HALF_UP)
--- a/tests/test_rounding.py
+++ b/tests/test_rounding.py
@@ -11,6 +11,19 @@
     def test_rounds_down_below_half(self):
         self.assertEqual(round_price(Decimal("2.344")), Decimal("2.34"))
 
+    def test_chf_rounds_to_nearest_five_rappen(self):
+        self.assertEqual(round_price(Decimal("2.02"), "CHF"), Decimal("2.00"))
+        self.assertEqual(round_price(Decimal("2.03"), "CHF"), Decimal("2.05"))
+        self.assertEqual(round_price(Decimal("2.07"), "CHF"), Decimal("2.05"))
+        self.assertEqual(round_price(Decimal("2.08"), "CHF"), Decimal("2.10"))
+
+    def test_chf_result_keeps_two_decimals(self):
+        self.assertEqual(round_price(Decimal("0"), "CHF"), Decimal("0.00"))
+
+    def test_no_currency_still_rounds_to_cent(self):
+        self.assertEqual(round_price(Decimal("2.021"), None), Decimal("2.02"))
+        self.assertEqual(round_price(Decimal("2.021"), "EUR"), Decimal("2.02"))
+
 
 if __name__ == "__main__":
     unittest.main()
