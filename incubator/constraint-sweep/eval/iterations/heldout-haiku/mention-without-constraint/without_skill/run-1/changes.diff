--- a/pricing/rounding.py
+++ b/pricing/rounding.py
@@ -2,8 +2,17 @@
 from decimal import ROUND_HALF_UP, Decimal
 
 CENT = Decimal("0.01")
+CHF_STEP = Decimal("0.05")
 
 
-def round_price(amount):
-    """Round a Decimal amount to the cent, with halves rounding up."""
+def round_price(amount, currency=None):
+    """Round a Decimal amount, with halves rounding up.
+
+    Without a currency, or for any currency other than "CHF", the amount is
+    rounded to the cent. Swiss cash prices ("CHF") are rounded to the nearest
+    0.05 instead.
+    """
+    if currency == "CHF":
+        steps = (amount / CHF_STEP).to_integral_value(rounding=ROUND_HALF_UP)
+        return (steps * CHF_STEP).quantize(CENT)
     return amount.quantize(CENT, rounding=ROUND_HALF_UP)
--- a/tests/test_rounding.py
+++ b/tests/test_rounding.py
@@ -11,6 +11,18 @@
     def test_rounds_down_below_half(self):
         self.assertEqual(round_price(Decimal("2.344")), Decimal("2.34"))
 
+    def test_no_currency_matches_cent_rounding(self):
+        self.assertEqual(round_price(Decimal("2.37")), Decimal("2.37"))
+        self.assertEqual(round_price(Decimal("2.374")), Decimal("2.37"))
+
+    def test_chf_rounds_to_nearest_five_cents(self):
+        self.assertEqual(round_price(Decimal("2.37"), "CHF"), Decimal("2.35"))
+        self.assertEqual(round_price(Decimal("2.38"), "CHF"), Decimal("2.40"))
+        self.assertEqual(round_price(Decimal("2.375"), "CHF"), Decimal("2.40"))
+        self.assertEqual(round_price(Decimal("2.374"), "CHF"), Decimal("2.35"))
+        self.assertEqual(round_price(Decimal("2.00"), "CHF"), Decimal("2.00"))
+        self.assertEqual(round_price(Decimal("0"), "CHF"), Decimal("0.00"))
+
 
 if __name__ == "__main__":
     unittest.main()
