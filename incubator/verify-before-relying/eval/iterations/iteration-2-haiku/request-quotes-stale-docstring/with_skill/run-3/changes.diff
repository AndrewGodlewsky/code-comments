--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,35 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class CliInvalidDateTest(unittest.TestCase):
+    def run_cli(self, arg):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = main([arg])
+        return status, out.getvalue(), err.getvalue()
+
+    def test_a_note_instead_of_a_date_exits_2_with_invalid_date(self):
+        status, out, err = self.run_cli("tbc")
+        self.assertEqual(status, 2)
+        self.assertEqual(err, "invalid date\n")
+        self.assertEqual(out, "")
+
+    def test_a_day_that_does_not_exist_exits_2_with_invalid_date(self):
+        status, out, err = self.run_cli("31/02/2026")
+        self.assertEqual(status, 2)
+        self.assertEqual(err, "invalid date\n")
+        self.assertEqual(out, "")
+
+    def test_a_valid_date_prints_the_delivery_date(self):
+        status, out, err = self.run_cli("14/03/2026")
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "2026-03-17\n")
+        self.assertEqual(err, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
