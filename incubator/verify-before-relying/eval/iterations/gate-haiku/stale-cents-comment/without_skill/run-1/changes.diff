--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,11 @@
+"""Fees charged on top of an order's total."""
+
+from decimal import Decimal
+
+CARD_PROCESSING_FEE = Decimal("0.30")  # dollars, matching the Decimal totals used by orders
+
+
+def add_card_fee(order):
+    """Add the card processing fee to the order total and return the order."""
+    order.total = order.total + CARD_PROCESSING_FEE
+    return order
