--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,11 @@
+"""Fees added to an order before payment."""
+
+from decimal import Decimal
+
+CARD_PROCESSING_FEE = Decimal("0.30")
+
+
+def add_card_fee(order):
+    """Add the 30-cent card processing fee to the order total and return the order."""
+    order.total = order.total + CARD_PROCESSING_FEE
+    return order
