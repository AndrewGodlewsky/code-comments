--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,12 @@
+"""Fees added to an order before payment."""
+
+CARD_FEE_CENTS = 30
+
+
+def add_card_fee(order):
+    """Add the 30-cent card processing fee to the order total and return the order.
+
+    Order totals are integer cents (see orders/model.py), so the fee is 30.
+    """
+    order.total = order.total + CARD_FEE_CENTS
+    return order
