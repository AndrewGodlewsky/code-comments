+++ b/orders/fees.py
@@ -0,0 +1,9 @@
+"""Fees charged on top of an order before payment."""
+
+CARD_FEE_CENTS = 30
+
+
+def add_card_fee(order):
+    """Add the 30-cent card processing fee to order.total and return the order."""
+    order.total = order.total + CARD_FEE_CENTS
+    return order
