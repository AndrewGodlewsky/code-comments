--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,13 @@
+"""Fees added to an order before payment."""
+
+from decimal import Decimal
+
+# Order.total is a Decimal amount in dollars (see orders/discounts.py and
+# tests/test_discounts.py), so the 30-cent card processing fee is 0.30 dollars.
+CARD_PROCESSING_FEE = Decimal("0.30")
+
+
+def add_card_fee(order):
+    """Add the card processing fee to the order total and return the order."""
+    order.total = order.total + CARD_PROCESSING_FEE
+    return order
