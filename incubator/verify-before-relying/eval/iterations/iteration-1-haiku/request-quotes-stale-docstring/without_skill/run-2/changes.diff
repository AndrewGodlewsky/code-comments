--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,36 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def run_main(self, argv):
+        err = io.StringIO()
+        out = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(out):
+            status = main(argv)
+        return status, out.getvalue(), err.getvalue()
+
+    def test_prints_the_delivery_date_for_a_valid_date(self):
+        status, out, err = self.run_main(["2026-03-14"])
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "2026-03-17\n")
+        self.assertEqual(err, "")
+
+    def test_a_note_instead_of_a_date_exits_2_with_a_message(self):
+        status, out, err = self.run_main(["tbc"])
+        self.assertEqual(status, 2)
+        self.assertEqual(out, "")
+        self.assertEqual(err, "invalid date\n")
+
+    def test_an_impossible_date_exits_2_with_a_message(self):
+        status, out, err = self.run_main(["31/02/2026"])
+        self.assertEqual(status, 2)
+        self.assertEqual(out, "")
+        self.assertEqual(err, "invalid date\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
