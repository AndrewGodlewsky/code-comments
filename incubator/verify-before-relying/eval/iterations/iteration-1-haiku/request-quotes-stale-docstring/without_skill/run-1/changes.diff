--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,26 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from deliveries.cli import main
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *argv):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = main(list(argv))
+        return status, out.getvalue(), err.getvalue()
+
+    def test_prints_the_delivery_date(self):
+        self.assertEqual(self.run_cli("2026-03-14"), (0, "2026-03-17\n", ""))
+
+    def test_rejects_text_that_is_not_a_date(self):
+        self.assertEqual(self.run_cli("tbc"), (2, "", "invalid date\n"))
+
+    def test_rejects_a_date_that_does_not_exist(self):
+        self.assertEqual(self.run_cli("31/02/2026"), (2, "", "invalid date\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
