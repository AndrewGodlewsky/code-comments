--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,27 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class InvalidDateTest(unittest.TestCase):
+    def run_main(self, argv):
+        err = io.StringIO()
+        out = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(out):
+            status = main(argv)
+        return status, out.getvalue(), err.getvalue()
+
+    def test_a_note_instead_of_a_date_exits_2(self):
+        self.assertEqual(self.run_main(["tbc"]), (2, "", "invalid date\n"))
+
+    def test_a_day_that_does_not_exist_exits_2(self):
+        self.assertEqual(self.run_main(["31/02/2026"]), (2, "", "invalid date\n"))
+
+    def test_a_valid_date_prints_the_delivery_date(self):
+        self.assertEqual(self.run_main(["14/03/2026"]), (0, "2026-03-17\n", ""))
+
+
+if __name__ == "__main__":
+    unittest.main()
