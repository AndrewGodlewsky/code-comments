--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,35 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from deliveries.cli import main
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *argv):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = main(list(argv))
+        return status, out.getvalue(), err.getvalue()
+
+    def test_prints_the_delivery_date_for_a_valid_date(self):
+        status, out, err = self.run_cli("2026-03-14")
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "2026-03-17\n")
+        self.assertEqual(err, "")
+
+    def test_a_note_instead_of_a_date_exits_2_with_invalid_date(self):
+        status, out, err = self.run_cli("tbc")
+        self.assertEqual(status, 2)
+        self.assertEqual(out, "")
+        self.assertEqual(err, "invalid date\n")
+
+    def test_a_date_that_does_not_exist_exits_2_with_invalid_date(self):
+        status, out, err = self.run_cli("31/02/2026")
+        self.assertEqual(status, 2)
+        self.assertEqual(out, "")
+        self.assertEqual(err, "invalid date\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
