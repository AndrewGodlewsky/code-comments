@@ -1,8 +1,16 @@
 """Invoice totals."""
 
-from decimal import Decimal
+from decimal import ROUND_HALF_UP, Decimal
+
+from money.rounding import CENT
 
 
 def invoice_total(lines):
-    """Return the invoice total: quantity times unit price, summed over the lines."""
-    return sum((line.quantity * line.unit_price for line in lines), Decimal("0"))
+    """Return the invoice total, rounded half up to the cent for the tax office.
+
+    The total is quantity times unit price, summed over the lines. It does not use
+    money.rounding.round_cents, which rounds halves to the even cent (the ledger
+    needs that to match the bank), not half up.
+    """
+    total = sum((line.quantity * line.unit_price for line in lines), Decimal("0"))
+    return total.quantize(CENT, rounding=ROUND_HALF_UP)
--- a/money/rounding.py
+++ b/money/rounding.py
@@ -6,5 +6,8 @@
 
 
 def round_cents(amount):
-    """Round amount to the nearest cent, rounding halves up."""
+    """Round amount to the nearest cent, rounding halves to the even cent (banker's rounding).
+
+    This matches the bank statement. It is not round-half-up.
+    """
     return amount.quantize(CENT)
