--- a/invoices/total.py
+++ b/invoices/total.py
@@ -1,8 +1,16 @@
 """Invoice totals."""
 
-from decimal import Decimal
+from decimal import ROUND_HALF_UP, Decimal
+
+from money.rounding import CENT
 
 
 def invoice_total(lines):
-    """Return the invoice total: quantity times unit price, summed over the lines."""
-    return sum((line.quantity * line.unit_price for line in lines), Decimal("0"))
+    """Return the invoice total: quantity times unit price, summed over the lines,
+    rounded half up to the cent as the tax office requires.
+
+    money.rounding.round_cents is not used here: it rounds halves to the even cent
+    (the ledger depends on that), despite its docstring saying half up.
+    """
+    total = sum((line.quantity * line.unit_price for line in lines), Decimal("0"))
+    return total.quantize(CENT, rounding=ROUND_HALF_UP)
