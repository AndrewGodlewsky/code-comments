--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,28 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class CliTest(unittest.TestCase):
+    def run_main(self, text):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            return main([text]), err.getvalue()
+
+    def test_prints_delivery_date(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            self.assertEqual(main(["2026-03-14"]), 0)
+        self.assertEqual(out.getvalue().strip(), "2026-03-17")
+
+    def test_unrecognised_text_is_invalid(self):
+        self.assertEqual(self.run_main("tbc"), (2, "invalid date\n"))
+
+    def test_nonexistent_date_is_invalid(self):
+        self.assertEqual(self.run_main("31/02/2026"), (2, "invalid date\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
