--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,23 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from deliveries.cli import main
+
+
+class CliInvalidDateTest(unittest.TestCase):
+    def run_cli(self, text):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = main([text])
+        return status, out.getvalue(), err.getvalue()
+
+    def test_unrecognised_text_is_invalid(self):
+        self.assertEqual(self.run_cli("tbc"), (2, "", "invalid date\n"))
+
+    def test_nonexistent_date_is_invalid(self):
+        self.assertEqual(self.run_cli("31/02/2026"), (2, "", "invalid date\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
