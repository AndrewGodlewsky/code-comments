--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,25 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def test_valid_date_prints_delivery_date(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            self.assertEqual(main(["2026-03-14"]), 0)
+        self.assertEqual(out.getvalue(), "2026-03-17\n")
+
+    def test_invalid_dates_print_error_and_return_2(self):
+        for text in ("tbc", "", "31/02/2026"):
+            out, err = io.StringIO(), io.StringIO()
+            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+                self.assertEqual(main([text]), 2)
+            self.assertEqual(out.getvalue(), "")
+            self.assertEqual(err.getvalue(), "invalid date\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
