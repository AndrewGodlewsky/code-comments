--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,22 @@
+import io
+import unittest
+from contextlib import redirect_stderr
+
+from deliveries.cli import main
+
+
+class CliTest(unittest.TestCase):
+    def test_invalid_date_reports_and_exits_2(self):
+        err = io.StringIO()
+        with redirect_stderr(err):
+            status = main(["tbc"])
+        self.assertEqual(status, 2)
+        self.assertEqual(err.getvalue().strip(), "invalid date")
+
+    def test_nonexistent_date_is_invalid(self):
+        with redirect_stderr(io.StringIO()):
+            self.assertEqual(main(["2026-02-30"]), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
