--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,26 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def test_prints_the_delivery_date(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            status = main(["2026-03-14"])
+        self.assertEqual(status, 0)
+        self.assertEqual(out.getvalue(), "2026-03-17\n")
+
+    def test_invalid_date_reports_on_stderr_and_exits_2(self):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = main(["31/02/2026"])
+        self.assertEqual(status, 2)
+        self.assertEqual(err.getvalue(), "invalid date\n")
+        self.assertEqual(out.getvalue(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
