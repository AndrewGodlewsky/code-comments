--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,9 @@
+"""Fees added to an order before payment."""
+
+CARD_FEE_CENTS = 30
+
+
+def add_card_fee(order):
+    """Add the 30-cent card processing fee to the order total and return the order."""
+    order.total += CARD_FEE_CENTS
+    return order
--- a/tests/test_fees.py
+++ b/tests/test_fees.py
@@ -0,0 +1,14 @@
+import unittest
+
+from orders.fees import add_card_fee
+from orders.model import Order
+
+
+class AddCardFeeTest(unittest.TestCase):
+    def test_adds_thirty_cents_to_the_total(self):
+        order = add_card_fee(Order("B-1", 1000))
+        self.assertEqual(order.total, 1030)
+
+
+if __name__ == "__main__":
+    unittest.main()
