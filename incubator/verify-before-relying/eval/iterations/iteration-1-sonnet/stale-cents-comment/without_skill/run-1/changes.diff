--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,12 @@
+"""Fees added to an order before payment."""
+
+from decimal import Decimal
+
+# Order totals are Decimal dollar amounts (see tests), so 30 cents is 0.30.
+CARD_FEE = Decimal("0.30")
+
+
+def add_card_fee(order):
+    """Add the 30-cent card processing fee to the order total and return the order."""
+    order.total = order.total + CARD_FEE
+    return order
