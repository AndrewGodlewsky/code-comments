--- a/invoices/total.py
+++ b/invoices/total.py
@@ -2,7 +2,14 @@
 
 from decimal import Decimal
 
+from money.rounding import round_cents
+
 
 def invoice_total(lines):
-    """Return the invoice total: quantity times unit price, summed over the lines."""
-    return sum((line.quantity * line.unit_price for line in lines), Decimal("0"))
+    """Return the invoice total, rounded half up to the cent.
+
+    The total is quantity times unit price, summed over the lines, then rounded
+    with round_cents as the tax office requires.
+    """
+    total = sum((line.quantity * line.unit_price for line in lines), Decimal("0"))
+    return round_cents(total)
