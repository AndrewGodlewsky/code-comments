--- a/invoices/total.py
+++ b/invoices/total.py
@@ -1,8 +1,13 @@
 """Invoice totals."""
 
-from decimal import Decimal
+from decimal import ROUND_HALF_UP, Decimal
+
+from money.rounding import CENT
 
 
 def invoice_total(lines):
-    """Return the invoice total: quantity times unit price, summed over the lines."""
-    return sum((line.quantity * line.unit_price for line in lines), Decimal("0"))
+    """Return the invoice total to the cent, quantity times unit price summed over the lines."""
+    # The tax office requires totals rounded half up. round_cents rounds halves to
+    # even for the ledger, so it cannot be used here.
+    total = sum((line.quantity * line.unit_price for line in lines), Decimal("0"))
+    return total.quantize(CENT, rounding=ROUND_HALF_UP)
--- a/money/rounding.py
+++ b/money/rounding.py
@@ -6,5 +6,5 @@
 
 
 def round_cents(amount):
-    """Round amount to the nearest cent, rounding halves up."""
+    """Round amount to the nearest cent, rounding halves to the even cent."""
     return amount.quantize(CENT)
