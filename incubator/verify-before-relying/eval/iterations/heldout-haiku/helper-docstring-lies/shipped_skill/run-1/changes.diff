@@ -1,10 +1,10 @@
 """Rounding for money amounts held as Decimal."""
 
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 CENT = Decimal("0.01")
 
 
-def round_cents(amount):
-    """Round amount to the nearest cent, rounding halves up."""
-    return amount.quantize(CENT)
+def round_cents(amount, rounding=ROUND_HALF_EVEN):
+    """Round amount to the nearest cent. Halves go to the even cent unless rounding says otherwise; the default matches the bank statement the ledger reconciles against."""
+    return amount.quantize(CENT, rounding=rounding)
