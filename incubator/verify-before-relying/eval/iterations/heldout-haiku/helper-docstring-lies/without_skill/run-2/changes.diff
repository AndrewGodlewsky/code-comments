 """Rounding for money amounts held as Decimal."""
 
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 CENT = Decimal("0.01")
 
 
-def round_cents(amount):
-    """Round amount to the nearest cent, rounding halves up."""
