--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,24 @@
+import io
+import unittest
+from contextlib import redirect_stderr
+
+from deliveries.cli import main
+
+
+class CliInvalidDateTest(unittest.TestCase):
+    def check_invalid(self, text):
+        err = io.StringIO()
+        with redirect_stderr(err):
+            status = main([text])
+        self.assertEqual(status, 2)
+        self.assertEqual(err.getvalue().strip(), "invalid date")
+
+    def test_unrecognised_text_is_invalid(self):
+        self.check_invalid("tbc")
+
+    def test_date_that_does_not_exist_is_invalid(self):
+        self.check_invalid("31/02/2026")
+
+
+if __name__ == "__main__":
+    unittest.main()
