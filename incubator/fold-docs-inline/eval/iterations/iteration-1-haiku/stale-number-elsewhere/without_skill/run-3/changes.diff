 PAGE_SIZE = 200
 
 
@@ -14,7 +16,13 @@
         self.sleep = sleep
 
     def get_page(self, page):
-        """Return one page of orders, or an empty list once every order has been read."""
+        """Return one page of orders, or an empty list once every order has been read.
+
+        A dropped request is retried up to ATTEMPTS times in total, with a growing
+        pause between attempts (see pause_after). The shop API drops about one
+        request in a thousand during its nightly maintenance (OPS-19), so retries
+        are expected rather than exceptional.
+        """
         for attempt in range(1, ATTEMPTS + 1):
             try:
                 return self.http.get("/orders", page=page, page_size=PAGE_SIZE)
