 def send_refund(session, refund):
+    """Post the refund to the payment provider and return the provider's refund id.
+
+    The refund's own id is sent as the Idempotency-Key. The provider refuses a
+    second refund with the same key, so a retried call never pays out twice.
+
+    The API keys behind `session` are rotated every 90 days by the platform team.
+
+    The provider's sandbox is wiped every Monday at 06:00 UTC, so test refunds
+    made before then disappear.
+    """
     response = session.post(
         "/v2/refunds",
         json={"payment": refund["payment_id"], "amount": str(refund["amount"])},
