 from decimal import Decimal
 
+# Refunds of 500 EUR or more need two approvers. This is finance's four-eyes
+# rule (decision PAY-31). Do not raise the threshold without finance's sign-off.
 SECOND_APPROVER_THRESHOLD = Decimal("500")
 
 
