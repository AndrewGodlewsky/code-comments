--- a/billing/lines.py
+++ b/billing/lines.py
@@ -12,6 +12,7 @@
 
 
 def invoice_lines(order):
-    """Return the order's items as invoice lines."""
+    """Return the order's items as invoice lines, sorted by SKU."""
     lines = [Line(item["sku"], item["description"], Decimal(item["amount"])) for item in order["items"]]
+    # Customers check printed invoices against packing slips, which list items by SKU.
     return sorted(lines, key=lambda line: line.sku)
--- a/billing/totals.py
+++ b/billing/totals.py
@@ -6,6 +6,8 @@
 
 
 def invoice_total(lines):
-    """Return the invoice total in euros, rounded to the cent."""
+    """Return the invoice total in euros, rounded half-up to the cent."""
     total = sum((line.amount for line in lines), Decimal("0"))
+    # Not Python's default half-even: the tax office's e-invoice validator rejects
+    # totals rounded half-even (FIN-88).
     return total.quantize(CENT, rounding=ROUND_HALF_UP)
