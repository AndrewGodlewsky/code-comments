 # invoicing
 
 Builds customer invoices from shop orders.
+
+## Who to ask
+
+Invoice disputes go to the finance team's FINQ queue, not to engineering. Questions about
+the e-invoice format go to the accounts-receivable lead.
--- a/billing/lines.py
+++ b/billing/lines.py
@@ -14,4 +14,6 @@
 def invoice_lines(order):
     """Return the order's items as invoice lines."""
     lines = [Line(item["sku"], item["description"], Decimal(item["amount"])) for item in order["items"]]
+    # Keep SKU order: customers check printed invoices against packing slips, which
+    # list items by SKU.
     return sorted(lines, key=lambda line: line.sku)
--- a/billing/totals.py
+++ b/billing/totals.py
@@ -8,4 +8,6 @@
 def invoice_total(lines):
     """Return the invoice total in euros, rounded to the cent."""
     total = sum((line.amount for line in lines), Decimal("0"))
+    # Round half-up, not Python's default half-even: the tax office's e-invoice
+    # validator rejects totals rounded half-even (FIN-88).
     return total.quantize(CENT, rounding=ROUND_HALF_UP)
