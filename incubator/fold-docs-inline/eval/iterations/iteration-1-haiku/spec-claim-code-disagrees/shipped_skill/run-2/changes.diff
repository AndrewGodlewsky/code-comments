@@ -2,4 +2,9 @@
 
 
 def normalise_name(name):
+    """Strip surrounding whitespace.
+
+    TODO(ACC-12): usernames are meant to be case-insensitive, but case is not
+    folded here yet, so "Ann" and "ann" are currently separate accounts.
+    """
     return name.strip()
--- a/accounts/users.py
