--- a/accounts/names.py
+++ b/accounts/names.py
@@ -2,4 +2,8 @@
 
 
 def normalise_name(name):
+    # Surrounding whitespace is ignored, so " kim " and "kim" are the same name.
+    # Case is NOT folded: "Ann" and "ann" are currently different accounts.
+    # ACC-12 asks for case-insensitive usernames; that is not implemented yet.
+    # TODO: decide on ACC-12, then fold case here and add a test for it.
     return name.strip()
--- a/accounts/users.py
+++ b/accounts/users.py
@@ -2,6 +2,8 @@
 
 from accounts.names import normalise_name
 
+# New accounts start as members. Only an admin may grant "editor", a rule
+# tightened after the March 2025 spam wave (ACC-30).
 DEFAULT_ROLE = "member"
 
 
@@ -14,6 +16,10 @@
         self._accounts = {}
 
     def register(self, name):
+        """Create an account with the default role.
+
+        Raises NameTaken if the normalised name is already in use.
+        """
         key = normalise_name(name)
         if key in self._accounts:
             raise NameTaken(name)
