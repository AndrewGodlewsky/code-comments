--- a/accounts/names.py
+++ b/accounts/names.py
@@ -2,4 +2,11 @@
 
 
 def normalise_name(name):
+    """Return the directory key for an account name.
+
+    Only surrounding whitespace is removed. Comparison is case-sensitive as
+    implemented, so "Ann" and "ann" are different keys. ACC-12 asks for
+    case-insensitive usernames, which this code does not do yet; confirm the
+    intent before changing either the code or this comment.
+    """
     return name.strip()
--- a/accounts/users.py
+++ b/accounts/users.py
@@ -2,6 +2,8 @@
 
 from accounts.names import normalise_name
 
+# New accounts start as members. Only an admin may grant editor, which was
+# limited to admins after the March 2025 spam wave (ACC-30).
 DEFAULT_ROLE = "member"
 
 
@@ -14,6 +16,11 @@
         self._accounts = {}
 
     def register(self, name):
+        """Create an account with the default role.
+
+        The name is normalised first (see normalise_name). Raises NameTaken
+        if that key is already in use.
+        """
         key = normalise_name(name)
         if key in self._accounts:
             raise NameTaken(name)
@@ -25,6 +32,11 @@
         return self._accounts.get(normalise_name(name))
 
     def grant_role(self, actor, name, role):
+        """Set an account's role.
+
+        Granting editor requires an admin actor and raises PermissionError
+        otherwise (ACC-30).
+        """
         account = self._accounts[normalise_name(name)]
         if role == "editor" and actor["role"] != "admin":
             raise PermissionError("only an admin can grant the editor role")
