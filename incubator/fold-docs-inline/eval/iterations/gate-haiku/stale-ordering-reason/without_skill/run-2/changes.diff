@@ -1,10 +0,0 @@
-# Stock feed
-
-- `stock_rows()` leaves out SKUs that have no stock.
-- `stock_rows()` must return rows sorted by SKU: `write_feed()` walks the rows and the
-  price list together in a single merge pass, and a row that arrives out of order is
-  silently skipped.
-- Each feed line is tab-separated: SKU, quantity and price.
-- Quantities are capped at `MAX_FEED_QTY` (9999) because the marketplace's feed format
-  has a four-digit quantity column and rejects the whole file if any value is longer
-  (MKT-204).
--- a/stock/feed.py
+++ b/stock/feed.py
@@ -4,7 +4,11 @@
 
 
 def write_feed(rows, prices, out):
-    """Write one line per stocked SKU that has a price."""
+    """Write one line per stocked SKU that has a price.
+
+    Each price is looked up by SKU, so rows may arrive in any order. Rows without a
+    price are skipped.
+    """
     for sku, qty in rows:
         price = prices.get(sku)
         if price is not None:
--- a/stock/format.py
+++ b/stock/format.py
@@ -1,5 +1,7 @@
 """The marketplace's feed line format."""
 
+# The marketplace's quantity column is four digits wide and it rejects the whole feed
+# file if any value is longer (MKT-204), so quantities are capped at this value.
 MAX_FEED_QTY = 9999
 
 
--- a/stock/rows.py
+++ b/stock/rows.py
@@ -2,5 +2,9 @@
 
 
 def stock_rows(levels):
-    """Return (sku, quantity) pairs for every SKU in stock."""
+    """Return (sku, quantity) pairs for every SKU in stock.
+
+    SKUs with no stock (quantity 0) are left out. The result is sorted by SKU so the
+    feed is written in a stable order; write_feed() does not depend on that order.
+    """
     return sorted((sku, qty) for sku, qty in levels.items() if qty > 0)
