+    """
     for sku, qty in rows:
         price = prices.get(sku)
         if price is not None:
--- a/stock/format.py
+++ b/stock/format.py
@@ -1,5 +1,7 @@
 """The marketplace's feed line format."""
 
+# The marketplace feed's quantity column is four digits wide. A longer value makes
+# the marketplace reject the whole file (MKT-204), so quantities are capped here.
 MAX_FEED_QTY = 9999
 
 
--- a/stock/rows.py
+++ b/stock/rows.py
@@ -2,5 +2,8 @@
 
 
 def stock_rows(levels):
-    """Return (sku, quantity) pairs for every SKU in stock."""
+    """Return (sku, quantity) pairs for every SKU in stock, sorted by SKU.
+
+    SKUs with no stock (quantity 0 or less) are left out.
+    """
     return sorted((sku, qty) for sku, qty in levels.items() if qty > 0)
