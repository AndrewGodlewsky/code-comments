--- a/notify/mail.py
+++ b/notify/mail.py
@@ -1,8 +1,11 @@
 """The digest e-mail."""
 
+# The company mail relay folds subject headers longer than this, and some mail clients
+# then show the subject garbled (MAIL-71).
 SUBJECT_LIMIT = 78
 
 
 def subject(user_name, count):
+    """Return the digest subject, cut to SUBJECT_LIMIT characters with a trailing '...'."""
     text = f"{user_name}, you have {count} unread notifications"
     return text if len(text) <= SUBJECT_LIMIT else text[: SUBJECT_LIMIT - 3] + "..."
