--- a/accounts/names.py
+++ b/accounts/names.py
@@ -2,4 +2,11 @@
 
 
 def normalise_name(name):
+    """Return the form a name is stored and looked up under.
+
+    Surrounding whitespace is ignored. Otherwise matching is exact: names are
+    not case-folded. Open issue: the older account rules say usernames are
+    case-insensitive (ACC-12), so "Ann" and "ann" are currently different
+    accounts. Decide whether to implement that or change the rule (ACC-12).
+    """
     return name.strip()
--- a/accounts/users.py
+++ b/accounts/users.py
@@ -14,6 +14,11 @@
         self._accounts = {}
 
     def register(self, name):
+        """Create an account with the default role.
+
+        Raises NameTaken if the normalised name is already in use. New accounts
+        are always DEFAULT_ROLE ("member"); see grant_role for elevated roles.
+        """
         key = normalise_name(name)
         if key in self._accounts:
             raise NameTaken(name)
@@ -25,6 +30,11 @@
         return self._accounts.get(normalise_name(name))
 
     def grant_role(self, actor, name, role):
+        """Set an account's role. Only an admin can grant "editor".
+
+        Editor rights were limited to admins after the March 2025 spam wave
+        (ACC-30). Raises PermissionError when a non-admin actor grants editor.
+        """
         account = self._accounts[normalise_name(name)]
         if role == "editor" and actor["role"] != "admin":
             raise PermissionError("only an admin can grant the editor role")
