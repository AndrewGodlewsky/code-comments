@@ -1,5 +1,7 @@
 """The digest e-mail."""
 
+# Subjects are cut to this many characters because the company mail relay folds longer
+# subject headers, and some mail clients then show the subject garbled (MAIL-71).
 SUBJECT_LIMIT = 78
 
 
