 """The marketplace's feed line format."""
 
+# The marketplace's quantity column is four digits wide. A longer value makes it
+# reject the whole feed file (MKT-204), so quantities are capped here.
 MAX_FEED_QTY = 9999
 
 
 def feed_line(sku, qty, price):
-    """One tab-separated feed line: SKU, quantity, price."""
+    """One tab-separated feed line: SKU, quantity, price.
+
+    The quantity is capped at MAX_FEED_QTY.
+    """
     return f"{sku}\t{min(qty, MAX_FEED_QTY)}\t{price}\n"
--- a/stock/rows.py
+++ b/stock/rows.py
@@ -2,5 +2,9 @@
 
 
 def stock_rows(levels):
-    """Return (sku, quantity) pairs for every SKU in stock."""
+    """Return (sku, quantity) pairs for every SKU in stock, sorted by SKU.
+
+    SKUs with no stock (quantity 0 or less) are left out. The sort is a convenience
+    only: write_feed() sorts its own rows, so callers need not rely on this order.
+    """
     return sorted((sku, qty) for sku, qty in levels.items() if qty > 0)
