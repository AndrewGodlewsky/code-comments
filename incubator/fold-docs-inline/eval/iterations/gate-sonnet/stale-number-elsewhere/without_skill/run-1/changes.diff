+++ b/orders/client.py
@@ -4,6 +4,7 @@
 
 from orders.settings import ATTEMPTS, RETRY_DELAY_SECONDS
 
+# The shop API rejects a page size above 250 with HTTP 400 and returns no orders.
 PAGE_SIZE = 200
 
 
