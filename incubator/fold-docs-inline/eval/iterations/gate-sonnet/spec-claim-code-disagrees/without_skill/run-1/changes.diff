--- a/accounts/names.py
+++ b/accounts/names.py
@@ -2,4 +2,8 @@
 
 
 def normalise_name(name):
+    # Surrounding spaces are ignored. Case is NOT folded: "Ann" and "ann" are
+    # different names today, although ACC-12 specifies case-insensitive
+    # usernames. Fixing that means lowercasing here, which affects register()
+    # and find_user() alike.
     return name.strip()
--- a/accounts/users.py
+++ b/accounts/users.py
@@ -2,6 +2,7 @@
 
 from accounts.names import normalise_name
 
+# Every new account starts with this role.
 DEFAULT_ROLE = "member"
 
 
@@ -14,6 +15,7 @@
         self._accounts = {}
 
     def register(self, name):
+        # Raises NameTaken if the normalised name is already in use.
         key = normalise_name(name)
         if key in self._accounts:
             raise NameTaken(name)
@@ -26,6 +28,8 @@
 
     def grant_role(self, actor, name, role):
         account = self._accounts[normalise_name(name)]
+        # Editor rights are limited to admins after the March 2025 spam wave
+        # (ACC-30).
         if role == "editor" and actor["role"] != "admin":
             raise PermissionError("only an admin can grant the editor role")
         account["role"] = role
--- a/docs/accounts.md
+++ b/docs/accounts.md
@@ -1,8 +0,0 @@
-# Accounts
-
-- Usernames are case-insensitive (ACC-12): `find_user("Ann")` and `find_user("ann")` find
-  the same account, and `register()` treats them as the same name.
-- Spaces before or after a name are ignored.
-- `register()` raises `NameTaken` when the name is already in use.
