 from decimal import Decimal
 
+# 500 EUR is the finance controller's four-eyes rule (decision PAY-31). Do not raise it
+# without finance's sign-off.
 SECOND_APPROVER_THRESHOLD = Decimal("500")
 
 
 def needs_second_approver(amount):
+    """True for refunds at or above the threshold (500 EUR or more)."""
     return amount >= SECOND_APPROVER_THRESHOLD
 
 
