 def send_refund(session, refund):
+    """Post the refund to the provider and return the provider's refund id."""
+    # The provider refuses a second refund with the same idempotency key, so using the
+    # refund's own id as the key means a retried call never pays out twice.
     response = session.post(
         "/v2/refunds",
         json={"payment": refund["payment_id"], "amount": str(refund["amount"])},
