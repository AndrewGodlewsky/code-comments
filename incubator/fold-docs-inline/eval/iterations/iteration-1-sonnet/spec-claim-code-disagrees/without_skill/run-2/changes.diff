--- a/accounts/names.py
+++ b/accounts/names.py
@@ -2,4 +2,6 @@
 
 
 def normalise_name(name):
+    # Only surrounding whitespace is removed. Case is preserved, so "Ann" and "ann"
+    # are different names.
     return name.strip()
--- a/accounts/users.py
+++ b/accounts/users.py
@@ -14,6 +14,10 @@
         self._accounts = {}
 
     def register(self, name):
+        """Create an account with the default role; raise NameTaken if the name is in use.
+
+        Names are compared after normalise_name, so surrounding spaces do not matter.
+        """
         key = normalise_name(name)
         if key in self._accounts:
             raise NameTaken(name)
@@ -25,6 +29,8 @@
         return self._accounts.get(normalise_name(name))
 
     def grant_role(self, actor, name, role):
+        # Only an admin can grant editor. Editor rights were limited to admins after
+        # the spam wave in March 2025 (ACC-30).
         account = self._accounts[normalise_name(name)]
         if role == "editor" and actor["role"] != "admin":
             raise PermissionError("only an admin can grant the editor role")
--- a/docs/accounts.md
+++ b/docs/accounts.md
@@ -1,8 +0,0 @@
-# Accounts
-
-- Usernames are case-insensitive (ACC-12): `find_user("Ann")` and `find_user("ann")` find
-  the same account, and `register()` treats them as the same name.
-- Spaces before or after a name are ignored.
-- `register()` raises `NameTaken` when the name is already in use.
-- New accounts get the `member` role. Only an admin can grant `editor`: editor rights were
-  limited to admins after the spam wave in March 2025 (ACC-30).
