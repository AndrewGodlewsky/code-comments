--- a/accounts/names.py
+++ b/accounts/names.py
@@ -2,4 +2,8 @@
 
 
 def normalise_name(name):
+    # Leading and trailing spaces are ignored.
+    # Case is NOT folded: "Ann" and "ann" are different names today, although
+    # ACC-12 (per the retired docs/accounts.md) says usernames should be
+    # case-insensitive. Unresolved: either fold case here or drop that requirement.
     return name.strip()
--- a/accounts/users.py
+++ b/accounts/users.py
@@ -2,6 +2,7 @@
 
 from accounts.names import normalise_name
 
+# Every new account starts with this role.
 DEFAULT_ROLE = "member"
 
 
@@ -26,6 +27,8 @@
 
     def grant_role(self, actor, name, role):
         account = self._accounts[normalise_name(name)]
+        # Only an admin can grant editor: editor rights were limited to admins
+        # after the spam wave in March 2025 (ACC-30).
         if role == "editor" and actor["role"] != "admin":
             raise PermissionError("only an admin can grant the editor role")
         account["role"] = role
--- a/docs/accounts.md
+++ b/docs/accounts.md
@@ -1,8 +0,0 @@
-# Accounts
-
-- Usernames are case-insensitive (ACC-12): `find_user("Ann")` and `find_user("ann")` find
-  the same account, and `register()` treats them as the same name.
-- Spaces before or after a name are ignored.
-- `register()` raises `NameTaken` when the name is already in use.
-- New accounts get the `member` role. Only an admin can grant `editor`: editor rights were
-  limited to admins after the spam wave in March 2025 (ACC-30).
