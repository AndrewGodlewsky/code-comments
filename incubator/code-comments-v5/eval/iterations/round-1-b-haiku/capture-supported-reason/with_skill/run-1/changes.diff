--- a/pipeline/stage.py
+++ b/pipeline/stage.py
@@ -7,5 +7,16 @@
 
 
 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    """Write each cleaned row to sink, ordered by cleaned customer_id.
+
+    The warehouse loader merge-joins each batch against the previous snapshot in a
+    single pass and silently skips rows that arrive out of order (DATA-412). The
+    loader is in another repository and cannot be changed, so this batch is sorted
+    here. The whole batch is held in memory to sort it.
+    """
+    cleaned = [clean(row) for row in rows]
+    # Sort on the trimmed id that is written: the loader joins on the stored value,
+    # so sorting the raw input before clean() would misorder ids with stray whitespace.
+    cleaned.sort(key=lambda row: row["customer_id"])
+    for row in cleaned:
+        sink.write(row)
