--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,26 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def run_main(self, argv):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = main(argv)
+        return status, out.getvalue(), err.getvalue()
+
+    def test_prints_the_delivery_date(self):
+        self.assertEqual(self.run_main(["2026-03-14"]), (0, "2026-03-17\n", ""))
+
+    def test_text_that_is_not_a_date_exits_2_with_invalid_date(self):
+        self.assertEqual(self.run_main(["tbc"]), (2, "", "invalid date\n"))
+
+    def test_a_date_that_does_not_exist_exits_2_with_invalid_date(self):
+        self.assertEqual(self.run_main(["31/02/2026"]), (2, "", "invalid date\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
