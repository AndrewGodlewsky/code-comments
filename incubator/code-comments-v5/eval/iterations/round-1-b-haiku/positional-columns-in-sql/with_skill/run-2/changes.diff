+-- numbered by position, and the header row is skipped, not read. The SELECT maps
+-- those positions, so it must match the order of COLUMNS in exporter/csv_out.py
+-- (currently id, account, amount, currency, ts). Reordering or inserting a column
+-- there means updating this SELECT, or every later field loads into the wrong
+-- column. currency (c4) is not loaded because ledger_raw has no currency column.
 INSERT INTO ledger_raw (entry_id, account_code, amount, posted_at)
-SELECT c1, c2, c3, c4
+SELECT c1, c2, c3, c5
