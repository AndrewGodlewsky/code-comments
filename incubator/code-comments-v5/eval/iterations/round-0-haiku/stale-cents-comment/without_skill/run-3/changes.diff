--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,10 @@
+"""Fees added to an order before payment."""
+
+# Flat card processing fee, in the same unit as Order.total (integer cents).
+CARD_PROCESSING_FEE_CENTS = 30
+
+
+def add_card_fee(order):
+    """Add the card processing fee to the order total and return the order."""
+    order.total = order.total + CARD_PROCESSING_FEE_CENTS
+    return order
--- a/tests/test_fees.py
+++ b/tests/test_fees.py
@@ -0,0 +1,21 @@
+import unittest
+
+from orders.fees import CARD_PROCESSING_FEE_CENTS, add_card_fee
+from orders.model import Order
+
+
+class AddCardFeeTest(unittest.TestCase):
+    def test_adds_thirty_cents_to_an_integer_cent_total(self):
+        order = add_card_fee(Order("A-2001", 1250))
+        self.assertEqual(order.total, 1280)
+
+    def test_returns_the_same_order(self):
+        order = Order("A-2002", 500)
+        self.assertIs(add_card_fee(order), order)
+
+    def test_fee_is_thirty_cents(self):
+        self.assertEqual(CARD_PROCESSING_FEE_CENTS, 30)
+
+
+if __name__ == "__main__":
+    unittest.main()
