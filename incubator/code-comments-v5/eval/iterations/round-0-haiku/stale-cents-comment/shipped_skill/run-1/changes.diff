--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,9 @@
+"""Fees charged on top of an order's total."""
+
+CARD_FEE_CENTS = 30  # card processing fee; Order.total is in integer cents
+
+
+def add_card_fee(order):
+    """Add the card processing fee to the order total and return the order."""
+    order.total = order.total + CARD_FEE_CENTS
+    return order
