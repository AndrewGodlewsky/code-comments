@@ -7,5 +7,13 @@
 
 
 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    """Write cleaned rows to sink sorted by the cleaned customer_id.
+
+    The warehouse loader merge-joins each batch against the previous snapshot
+    on customer_id in a single pass and silently skips rows that arrive out of
+    order (DATA-412). It lives in another repository, so the batch is sorted here.
+    """
+    cleaned = [clean(row) for row in rows]
+    cleaned.sort(key=lambda row: row["customer_id"])
+    for row in cleaned:
+        sink.write(row)
