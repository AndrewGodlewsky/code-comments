 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    # The warehouse loader merge-joins each batch against the previous snapshot
+    # in a single pass and silently skips rows that arrive out of order (DATA-412),
+    # so each batch must be written sorted by customer_id. Sort after clean(), since
+    # the trimmed id is the one the loader compares.
+    cleaned = sorted((clean(row) for row in rows), key=lambda row: row["customer_id"])
+    for row in cleaned:
+        sink.write(row)
