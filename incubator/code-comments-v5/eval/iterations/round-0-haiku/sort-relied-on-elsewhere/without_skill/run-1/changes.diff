+class NightlyExportOrderTest(unittest.TestCase):
+    def test_export_is_sorted_by_id(self):
+        from io import StringIO
+        from ledger.nightly import export
+
+        conn = connect()
+        add_entries(conn, [("E-0003", "4000", 500, "rent"), ("E-0001", "4100", 120, "coffee"),
+                           ("E-0002", "4100", 75, "")])
+        fh = StringIO()
+        export(conn, fh)
+        out = fh.getvalue()
+        self.assertLess(out.index("E-0001"), out.index("E-0002"))
+        self.assertLess(out.index("E-0002"), out.index("E-0003"))
+
