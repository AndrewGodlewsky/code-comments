 # Changelog
+
+## Unreleased
+- The balances API skips sorting the rows it adds up (`fetch_rows(conn, ordered=False)`). The nightly export keeps the id order the bank upload requires.
 
 ## 2.1.0
 - The balances API reports a total for each account as well as the overall total.
--- a/ledger/api.py
+++ b/ledger/api.py
@@ -7,6 +7,6 @@
 def balances(conn):
     """Return {"accounts": {account: pence}, "total": pence} over every ledger row."""
     per_account = defaultdict(int)
-    for row in fetch_rows(conn):
+    for row in fetch_rows(conn, ordered=False):
         per_account[row.account] += row.amount_pence
     return {"accounts": dict(per_account), "total": sum(per_account.values())}
--- a/ledger/rows.py
+++ b/ledger/rows.py
@@ -4,9 +4,15 @@
 Row = namedtuple("Row", "id account amount_pence memo")
 
 
-def fetch_rows(conn):
-    """Return the ledger rows."""
+def fetch_rows(conn, ordered=True):
+    """Return the ledger rows.
+
+    With ordered=True (the default) rows are sorted by id. The nightly bank
+    upload depends on that order, so only callers that do not care about order
+    (such as the balances API) should pass ordered=False.
+    """
     cursor = conn.execute("SELECT id, account, amount_pence, memo FROM entries")
     rows = [Row(*record) for record in cursor.fetchall()]
-    rows.sort(key=lambda row: row.id)
+    if ordered:
+        rows.sort(key=lambda row: row.id)
     return rows
