--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,26 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class CliTest(unittest.TestCase):
+    def test_invalid_date_prints_message_to_stderr_and_returns_2(self):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = main(["tbc"])
+        self.assertEqual(status, 2)
+        self.assertEqual(err.getvalue().strip(), "invalid date")
+        self.assertEqual(out.getvalue(), "")
+
+    def test_valid_date_prints_delivery_date(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            status = main(["2026-03-14"])
+        self.assertEqual(status, 0)
+        self.assertEqual(out.getvalue().strip(), "2026-03-17")
+
+
+if __name__ == "__main__":
+    unittest.main()
