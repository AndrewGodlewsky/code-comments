--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,19 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def test_an_invalid_date_reports_to_stderr_and_exits_with_status_2(self):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = main(["tbc"])
+        self.assertEqual(status, 2)
+        self.assertEqual(err.getvalue(), "invalid date\n")
+        self.assertEqual(out.getvalue(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
