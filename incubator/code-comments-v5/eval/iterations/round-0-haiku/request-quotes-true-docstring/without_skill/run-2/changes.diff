--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,19 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def test_invalid_date_prints_message_to_stderr_and_returns_2(self):
+        stdout, stderr = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            status = main(["not-a-date"])
+        self.assertEqual(status, 2)
+        self.assertEqual(stderr.getvalue(), "invalid date\n")
+        self.assertEqual(stdout.getvalue(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
