@@ -7,5 +7,14 @@
 
 
 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    """Write rows to sink in ascending customer_id order.
+
+    The warehouse loader (a separate repository) merge-joins each batch against
+    the previous snapshot in a single pass and silently skips rows that arrive
+    out of order, so this ordering is required (DATA-412).
+    """
+    # Sort after clean(): the loader sees the trimmed id, so ordering raw values
+    # could place rows differently from the order it reads.
+    cleaned = sorted((clean(row) for row in rows), key=lambda row: row["customer_id"])
+    for row in cleaned:
+        sink.write(row)
