@@ -7,5 +7,12 @@
 
 
 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    # The warehouse loader merge-joins each batch against the previous snapshot
+    # in a single pass and silently skips rows that arrive out of customer_id
+    # order (DATA-412). The loader is in another repository and cannot be changed
+    # here, so each batch is sorted by the cleaned customer_id before writing.
+    # Sorting after clean() keeps the order of the id that is actually written.
+    cleaned = [clean(row) for row in rows]
+    cleaned.sort(key=lambda row: row["customer_id"])
+    for row in cleaned:
+        sink.write(row)
