--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,30 @@
+"""Tests for the deliveries command line."""
+import io
+import contextlib
+import unittest
+
+from deliveries.cli import main
+
+
+class CliTest(unittest.TestCase):
+    def run_cli(self, *args):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = main(list(args))
+        return status, out.getvalue(), err.getvalue()
+
+    def test_prints_the_delivery_date_for_a_valid_date(self):
+        status, out, err = self.run_cli("2026-03-14")
+        self.assertEqual((status, out, err), (0, "2026-03-17\n", ""))
+
+    def test_rejects_text_that_is_not_a_date(self):
+        status, out, err = self.run_cli("tbc")
+        self.assertEqual((status, out, err), (2, "", "invalid date\n"))
+
+    def test_rejects_a_date_that_does_not_exist(self):
+        status, out, err = self.run_cli("31/02/2026")
+        self.assertEqual((status, out, err), (2, "", "invalid date\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
