--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,26 @@
+import contextlib
+import io
+import unittest
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def run_cli(self, argv):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = main(argv)
+        return status, out.getvalue(), err.getvalue()
+
+    def test_prints_the_delivery_date(self):
+        self.assertEqual(self.run_cli(["2026-03-14"]), (0, "2026-03-17\n", ""))
+
+    def test_a_non_date_is_rejected_with_status_2(self):
+        self.assertEqual(self.run_cli(["tbc"]), (2, "", "invalid date\n"))
+
+    def test_a_date_that_does_not_exist_is_rejected_with_status_2(self):
+        self.assertEqual(self.run_cli(["31/02/2026"]), (2, "", "invalid date\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
