--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,25 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def test_prints_the_delivery_date(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            self.assertEqual(main(["2026-03-14"]), 0)
+        self.assertEqual(out.getvalue(), "2026-03-17\n")
+
+    def test_an_invalid_date_exits_2_with_a_message(self):
+        for text in ["tbc", "31/02/2026"]:
+            with self.subTest(text=text):
+                err = io.StringIO()
+                with redirect_stderr(err):
+                    self.assertEqual(main([text]), 2)
+                self.assertEqual(err.getvalue(), "invalid date\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
