+++ b/orders/fees.py
@@ -0,0 +1,9 @@
+"""Fees added to an order at checkout."""
+
+CARD_FEE_CENTS = 30
+
+
+def add_card_fee(order):
+    """Add the card processing fee to the order total, in integer cents, and return the order."""
+    order.total += CARD_FEE_CENTS
+    return order
