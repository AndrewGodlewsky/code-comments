--- a/orders/fees.py
+++ b/orders/fees.py
@@ -0,0 +1,9 @@
+"""Fees added to an order before payment."""
+
+CARD_PROCESSING_FEE = 30  # cents, matching Order.total's integer-cent unit
+
+
+def add_card_fee(order):
+    """Add the card processing fee to the order total and return the order."""
+    order.total += CARD_PROCESSING_FEE
+    return order
