--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -0,0 +1,26 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from deliveries.cli import main
+
+
+class MainTest(unittest.TestCase):
+    def test_prints_the_delivery_date(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            status = main(["2026-03-14"])
+        self.assertEqual(status, 0)
+        self.assertEqual(out.getvalue(), "2026-03-17\n")
+
+    def test_an_invalid_date_exits_with_status_2(self):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = main(["tbc"])
+        self.assertEqual(status, 2)
+        self.assertEqual(err.getvalue(), "invalid date\n")
+        self.assertEqual(out.getvalue(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
