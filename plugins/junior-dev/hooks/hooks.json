{
  "description": "Record plan and diagram files as they are written, remind the agent to run junior-dev on them, and block a stop once if one was never reviewed. Works in Claude Code and GitHub Copilot (CLI and VS Code); bash and powershell are the per-shell forms Copilot uses.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|create|edit|str_replace_editor|apply_patch",
        "hooks": [{"type": "command",
                   "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" post-write",
                   "bash": "python \"$CLAUDE_PLUGIN_ROOT/scripts/hooks.py\" post-write",
                   "powershell": "python \"$env:CLAUDE_PLUGIN_ROOT/scripts/hooks.py\" post-write"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command",
                   "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" stop",
                   "bash": "python \"$CLAUDE_PLUGIN_ROOT/scripts/hooks.py\" stop",
                   "powershell": "python \"$env:CLAUDE_PLUGIN_ROOT/scripts/hooks.py\" stop"}]
      }
    ]
  }
}
