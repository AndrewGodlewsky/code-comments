{
  "description": "Record plan and diagram files as they are written, remind the agent to run junior-dev on them, and block a stop once if one was never reviewed.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" post-write"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" stop"}]
      }
    ]
  }
}
