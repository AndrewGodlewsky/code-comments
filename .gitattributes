* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve imported source bytes and upstream patches, including original whitespace.
docs/books/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/papers/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/research/ai-code-comments/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
evaluation/pilot/chain/**/*.diff -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Recorded pilot output is data: keep it byte for byte.
evaluation/pilot/runs/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Recorded incubator eval runs are data: agents' edits and replies keep their own whitespace.
incubator/*/eval/iterations/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
