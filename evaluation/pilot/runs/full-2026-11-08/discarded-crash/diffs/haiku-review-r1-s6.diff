+def test_contains_all_null_items_pyarrow() -> None:
+    pytest.importorskip("pyarrow")
+    import pyarrow as pa
+
+    # The inner type is `null`, so there is nothing for a non-null item to match.
+    df = nw.from_native(pa.table({"a": [[None, None], [None], None]}))
+    result = df.select(
+        one=nw.col("a").list.contains(1), flag=nw.col("a").list.contains(True)
+    )
+    expected = {"one": [False, False, None], "flag": [False, False, None]}
+    assert_equal_data(result, expected)
+
