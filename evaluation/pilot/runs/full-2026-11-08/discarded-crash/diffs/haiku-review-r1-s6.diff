+def test_contains_string_variants_pyarrow() -> None:
+    pytest.importorskip("pyarrow")
+    import pyarrow as pa
+
+    # `large_string` and dictionary-encoded inner values are comparable with a `str` item.
+    large = pa.array([["x"], ["y"]], pa.list_(pa.large_string()))
+    dict_type = pa.dictionary(pa.int32(), pa.string())
+    dictionary = pa.array([["x"], ["y"]], pa.list_(dict_type))
+    df = nw.from_native(pa.table({"large": large, "dict": dictionary}))
+    result = df.select(
+        large=nw.col("large").list.contains("x"), dict=nw.col("dict").list.contains("x")
+    )
+    assert_equal_data(result, {"large": [True, False], "dict": [True, False]})
+
