 def list_contains(array: ChunkedArrayAny, item: Any) -> ChunkedArrayAny:
+    inner = cast("pa.ListType", array.type).value_type
+    # NOTE: `pc.equal` silently casts between some incomparable types (e.g. timestamps
+    # of different units, or dates and timestamps), so check the types ourselves.
+    if item is not None and not pa.types.is_null(inner):
+        item_type = lit(item).type
+        if _list_item_category(item_type) != _list_item_category(inner):
+            msg = (
+                f"`list.contains` cannot check for `{item_type}` items "
