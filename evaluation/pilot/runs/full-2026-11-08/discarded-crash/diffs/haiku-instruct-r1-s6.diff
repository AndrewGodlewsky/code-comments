+def _list_item_matches(flat: ArrayAny, item: pa.Scalar[Any]) -> ArrayAny:
+    from pyarrow import (
+        ArrowInvalid,  # ignore-banned-imports
+        ArrowNotImplementedError,  # ignore-banned-imports
+        ArrowTypeError,  # ignore-banned-imports
+    )
+
+    msg = (
+        f"`list.contains` cannot check for {item.type} values "
+        f"in a list of {flat.type}."
+    )
+    # pyarrow silently casts between timestamp units, Polars does not.
+    if (
+        pa.types.is_timestamp(flat.type)
+        and pa.types.is_timestamp(item.type)
+        and flat.type.unit != item.type.unit
+    ):
+        raise InvalidOperationError(msg)
+    try:
+        equal = pc.equal(flat, item)
+    except (ArrowInvalid, ArrowNotImplementedError, ArrowTypeError) as exc:
+        raise InvalidOperationError(msg) from exc
+    return pc.fill_null(equal, lit(False))
+
+
 def list_contains(array: ChunkedArrayAny, item: NonNestedLiteral) -> ChunkedArrayAny:
     # Per-list match counts come from a prefix sum over the flattened values,
     # so the cost is linear in the total number of elements.
@@ -652,7 +677,7 @@ def list_contains(array: ChunkedArrayAny, item: NonNestedLiteral) -> ChunkedArra
     if item is None:
         matches = pc.is_null(flat)
     else:
-        matches = pc.fill_null(pc.equal(flat, lit(item)), lit(False))
+        matches = _list_item_matches(flat, lit(item))
     prefix = pa.concat_arrays(
         [pa.array([0], type=pa.int64()), pc.cumulative_sum(matches.cast(pa.int64()))]
     )
