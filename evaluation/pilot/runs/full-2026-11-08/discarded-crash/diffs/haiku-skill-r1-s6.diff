+def _is_pyarrow_list_constructor(constructor: Constructor) -> bool:
+    return any(backend in str(constructor) for backend in ("pandas", "modin", "dask"))
+
+
+@pytest.mark.parametrize(
+    ("values", "dtype", "item"),
+    [
+        ([[1, 2]], nw.Int64(), True),
+        ([[1, 2]], nw.Int64(), "x"),
+        ([[True]], nw.Boolean(), 1),
+        ([["x"]], nw.String(), 1),
+        ([[datetime(2020, 1, 1)]], nw.Datetime("ns"), datetime(2020, 1, 1)),
+        ([[datetime(2020, 1, 1)]], nw.Datetime("us"), date(2020, 1, 1)),
+        ([[timedelta(1)]], nw.Duration("ns"), timedelta(1)),
+        ([[time(1)]], nw.Time(), 1),
+        ([[b"x"]], nw.Binary(), "x"),
+        ([[Decimal("1.50")]], nw.Decimal(38, 2), Decimal("1.505")),
+        ([[1, 2]], nw.Int64(), b"x"),
+        ([[1, 2]], nw.Int64(), time(1)),
+        ([[1, 2]], nw.Int64(), timedelta(1)),
+    ],
+)
+@pytest.mark.parametrize("num_rows", [1, 0])
