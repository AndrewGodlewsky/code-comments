+def _list_contains_scalar(
+    item: NonNestedLiteral, value_type: pa.DataType
+) -> ScalarAny | None:
+    """Return `item` as a scalar of `value_type`, or `None` if no element can equal it.
+
+    Raises `InvalidOperationError` when `item` cannot be compared with `value_type`.
+    """
+    if pa.types.is_null(value_type):
+        return None
+    if isinstance(item, bool):
+        if pa.types.is_boolean(value_type):
+            return pa.scalar(item, type=value_type)
+    elif isinstance(item, (int, float, Decimal)):
+        if pa.types.is_floating(value_type):
+            return pa.scalar(float(item), type=value_type)
+        if pa.types.is_integer(value_type):
+            # `pa.scalar(1.5, type=int64)` silently truncates to 1, so only integral
+            # values are converted; everything else matches nothing.
+            if isinstance(item, (float, Decimal)) and not math.isfinite(item):
+                return None
+            if item != int(item):
+                return None
+            value = int(item)
+            bits = value_type.bit_width
+            if pa.types.is_signed_integer(value_type):
+                low, high = -(2 ** (bits - 1)), 2 ** (bits - 1) - 1
+            else:
+                low, high = 0, 2**bits - 1
+            if not low <= value <= high:
+                return None
+            return pa.scalar(value, type=value_type)
+        if pa.types.is_decimal(value_type) and isinstance(item, Decimal):
+            try:
+                return pa.scalar(item, type=value_type)
+            except pa.ArrowInvalid as exc:
+                # e.g. `Decimal("1.505")` against `Decimal(38, 2)`: pyarrow rescales
+                # with data loss, which Polars also rejects.
+                msg = (
+                    "`list.contains` cannot check for "
+                    f"{value_type} values in {item!r} data"
+                )
+                raise InvalidOperationError(msg) from exc
+    elif isinstance(item, datetime):
+        # Python datetimes are microsecond precision; a finer or coarser list is a
+        # mismatch, as in Polars.
+        if (
+            pa.types.is_timestamp(value_type)
+            and value_type.unit == "us"
+            and (value_type.tz is None) == (item.tzinfo is None)
+        ):
+            return pa.scalar(item, type=value_type)
+    elif isinstance(item, date):
+        if pa.types.is_date(value_type):
+            return pa.scalar(item, type=value_type)
+    elif isinstance(item, str):
+        if pa.types.is_string(value_type) or pa.types.is_large_string(value_type):
+            return pa.scalar(item, type=value_type)
+    elif isinstance(item, bytes):
+        if pa.types.is_binary(value_type) or pa.types.is_large_binary(value_type):
+            return pa.scalar(item, type=value_type)
+    elif isinstance(item, time):
+        if pa.types.is_time64(value_type):
+            return pa.scalar(item, type=value_type)
+    if isinstance(item, timedelta):
+        if pa.types.is_duration(value_type) and value_type.unit == "us":
+            return pa.scalar(item, type=value_type)
+    msg = (
+        f"`list.contains` cannot check for {value_type} values in "
+        f"{type(item).__name__} data"
+    )
+    raise InvalidOperationError(msg)
+
