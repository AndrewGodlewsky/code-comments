+def check_list_item(inner: pa.DataType, item: NonNestedLiteral) -> None:
+    if item is None or pa.types.is_null(inner):
+        return
+    if isinstance(item, bool):
+        comparable = pa.types.is_boolean(inner)
+    elif isinstance(item, numbers.Real):
+        comparable = pa.types.is_integer(inner) or pa.types.is_floating(inner)
+    elif isinstance(item, str):
+        comparable = pa.types.is_string(inner) or pa.types.is_large_string(inner)
+    elif isinstance(item, bytes):
+        comparable = pa.types.is_binary(inner) or pa.types.is_large_binary(inner)
+    elif isinstance(item, Decimal):
+        comparable = (
+            pa.types.is_decimal(inner)
+            or pa.types.is_integer(inner)
+            or pa.types.is_floating(inner)
+        )
+    else:
+        # Dates, datetimes, numpy bools and datetime64s: pyarrow infers their type.
+        item_type = pa.scalar(item).type
+        if pa.types.is_timestamp(item_type):
+            comparable = pa.types.is_timestamp(inner) and inner.unit == item_type.unit
+        elif pa.types.is_date(item_type):
+            comparable = pa.types.is_date(inner)
+        else:
+            comparable = pa.types.is_boolean(item_type) and pa.types.is_boolean(inner)
+    if not comparable:
+        name = type(item).__name__
+        msg = f"`list.contains` cannot check for {name} values in {inner} lists"
+        raise InvalidOperationError(msg)
+
+
+def _list_item_matches(values: ArrayAny, item: NonNestedLiteral) -> ArrayAny:
+    inner = values.type
+    n = len(values)
+    if pa.types.is_null(inner):
+        # pyarrow can't cast a non-null item to the null type, so nothing matches.
+        return pa.repeat(False, n)
+    check_list_item(inner, item)
+    if pa.types.is_integer(inner) and not _is_whole(item):
+        # pyarrow would truncate `1.5` to `1`.
+        return pa.repeat(False, n)
+    try:
+        scalar = pa.scalar(item, type=inner)
+    except (OverflowError, pa.ArrowInvalid):
+        # Out of range or too many digits for `inner`, so no element can equal `item`.
+        return pa.repeat(False, n)
+    return pc.fill_null(pc.equal(values, scalar), False)
+
+
+def _is_whole(item: NonNestedLiteral) -> bool:
+    if isinstance(item, Decimal):
+        return item == item.to_integral_value()
+    if isinstance(item, float):
+        return item.is_integer()
+    return True
