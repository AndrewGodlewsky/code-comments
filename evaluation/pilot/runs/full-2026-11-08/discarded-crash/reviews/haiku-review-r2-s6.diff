+def skip_unless_pyarrow_backed(constructor: Constructor) -> None:
+    backends = ("pandas", "modin", "dask", "pyarrow")
+    if not any(backend in str(constructor) for backend in backends):
+        reason = "Only pyarrow-backed backends raise `InvalidOperationError`."
+        pytest.skip(reason=reason)
+
+
+@pytest.mark.parametrize(
+    ("values", "dtype", "item"),
+    [
+        ([[1, 2]], nw.Int64(), True),
+        ([[1, 2]], nw.Int64(), "a"),
+        ([[1, 2]], nw.Int64(), date(2020, 1, 1)),
+        ([[1, 2]], nw.Int64(), timedelta(days=1)),
+        ([[1, 2]], nw.Int64(), time(12, 0)),
+        ([[timedelta(days=1)]], nw.Duration("ms"), timedelta(days=1)),
+        ([["a", "b"]], nw.String(), b"a"),
+        ([[date(2020, 1, 1)]], nw.Date(), "2020-01-01"),
+        ([[True]], nw.Boolean(), 1),
+        ([[datetime(2020, 1, 1)]], nw.Datetime("ms"), datetime(2020, 1, 1)),
+        ([[datetime(2020, 1, 1)]], nw.Datetime("ns"), datetime(2020, 1, 1)),
+        (
+            [[datetime(2020, 1, 1)]],
+            nw.Datetime("us"),
+            datetime(2020, 1, 1, tzinfo=timezone.utc),
+        ),
+    ],
+)
+@pytest.mark.parametrize("empty", [False, True], ids=["rows", "no_rows"])
+def test_contains_incompatible_item_raises(
+    request: pytest.FixtureRequest,
+    constructor: Constructor,
+    values: list[Any],
+    dtype: DType,
+    item: Any,
+    empty: bool,
+) -> None:
+    skip_or_xfail_unsupported(request, constructor)
+    skip_unless_pyarrow_backed(constructor)
+    df = nw.from_native(constructor({"a": values})).select(
+        nw.col("a").cast(nw.List(dtype))
+    )
+    if empty:
+        df = df.head(0)
+    with pytest.raises(InvalidOperationError):
+        df.select(nw.col("a").list.contains(item)).lazy().collect()
+
+
+@pytest.mark.parametrize(
+    ("values", "dtype", "item"),
+    [
+        ([[datetime(2020, 1, 1)]], nw.Datetime("us"), datetime(2020, 1, 1)),
+        ([[timedelta(days=1)]], nw.Duration("us"), timedelta(days=1)),
