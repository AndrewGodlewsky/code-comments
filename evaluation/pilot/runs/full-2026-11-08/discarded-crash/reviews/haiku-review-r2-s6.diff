+def _list_contains_family(dtype: pa.DataType) -> str | None:
+    if pa.types.is_boolean(dtype):
+        return "bool"
+    if (
+        pa.types.is_integer(dtype)
+        or pa.types.is_floating(dtype)
+        or pa.types.is_decimal(dtype)
+    ):
+        return "numeric"
+    if pa.types.is_string(dtype) or pa.types.is_large_string(dtype):
+        return "string"
+    if pa.types.is_binary(dtype) or pa.types.is_large_binary(dtype):
+        return "binary"
+    if pa.types.is_date(dtype):
+        return "date"
+    if pa.types.is_timestamp(dtype):
+        return "timestamp"
+    if pa.types.is_duration(dtype):
+        return "duration"
+    return None
+
+
+def _list_contains_error(item: NonNestedLiteral, value_type: pa.DataType) -> str:
+    return f"`list.contains` cannot check for {item!r} in a list of {value_type} values"
+
+
+def _is_list_contains_compatible(
+    value_type: pa.DataType, item: NonNestedLiteral
+) -> bool:
+    # Checks types rather than data, so that empty frames raise too. Without this,
+    # pyarrow would silently cast some mismatches (e.g. `str` vs `date`).
+    if item is None or pa.types.is_null(value_type):
+        return True
+    item_type = pa.scalar(item).type
+    value_family = _list_contains_family(value_type)
+    item_family = _list_contains_family(item_type)
+    if value_family is None or item_family is None:
+        return True
+    if value_family != item_family:
+        return False
+    # Units must match. Mixing tz-aware and naive datetimes only fails once there is
+    # data, so it is rejected here too, to behave the same on empty frames.
+    if isinstance(value_type, pa.TimestampType) and isinstance(
+        item_type, pa.TimestampType
+    ):
+        return value_type.unit == item_type.unit and (value_type.tz is None) == (
+            item_type.tz is None
+        )
+    if isinstance(value_type, pa.DurationType) and isinstance(
+        item_type, pa.DurationType
+    ):
+        return value_type.unit == item_type.unit
+    return True
+
+
 def list_contains(array: ChunkedArrayAny, item: NonNestedLiteral) -> ChunkedArrayAny:
+    value_type = array.type.value_type
+    if not _is_list_contains_compatible(value_type, item):
+        raise InvalidOperationError(_list_contains_error(item, value_type))
