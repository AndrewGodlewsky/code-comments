@@ -563,6 +563,21 @@ def list_agg(
     )
 
 
+def list_contains(array: ChunkedArrayAny, item: Any) -> ChunkedArrayAny:
+    # Explode once and mark the rows that hold a match, so the cost is linear in
+    # the number of list elements rather than per row.
+    values = pc.list_flatten(array)
+    if item is None:
+        matched = pc.is_null(values)
+    else:
+        matched = pc.fill_null(pc.equal(values, pa.scalar(item, type=values.type)), False)
+    hit_rows = pc.filter(pc.list_parent_indices(array), matched)
+    if isinstance(hit_rows, pa.ChunkedArray):
+        hit_rows = hit_rows.combine_chunks()
+    has_match = pc.is_in(arange(0, len(array), 1), value_set=hit_rows)
+    return pc.if_else(pc.is_null(array), pa.scalar(None, pa.bool_()), has_match)
+
+
