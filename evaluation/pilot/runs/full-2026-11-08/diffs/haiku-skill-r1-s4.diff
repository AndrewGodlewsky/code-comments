diff --git a/tests/frame/sort_test.py b/tests/frame/sort_test.py
index 7d62693..5246c4b 100644
--- a/tests/frame/sort_test.py
+++ b/tests/frame/sort_test.py
@@ -1,10 +1,13 @@
 from __future__ import annotations
 
+import re
 from typing import Any
 
 import pytest
 
 import narwhals as nw
+import narwhals.stable.v1 as nw_v1
+import narwhals.stable.v2 as nw_v2
 from tests.utils import Constructor, assert_equal_data, skip_if_no_categorical_ordering
 
 
@@ -110,3 +113,30 @@ def test_sort_dictionary_pyarrow(
     assert_equal_data(result, {"c": expected})
     # ordering does not decode the output
     assert result.to_native().schema == native.schema
+
+
+@pytest.mark.parametrize("module", [nw, nw_v1, nw_v2])
+def test_sort_descending_length_mismatch(constructor: Constructor, module: Any) -> None:
+    df = module.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    msg = "the length of `descending` (1) does not match the length of `by` (2)"
+    with pytest.raises(ValueError, match=re.escape(msg)):
+        df.sort("a", "b", descending=[True])
+
+
+@pytest.mark.parametrize("flag", ["abc", 1, 0, None])
+@pytest.mark.parametrize("module", [nw, nw_v1, nw_v2])
+def test_sort_descending_non_bool(
+    constructor: Constructor, module: Any, flag: Any
+) -> None:
+    df = module.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    with pytest.raises(TypeError, match="is not an instance of 'bool'") as exc:
+        df.sort("a", "b", descending=[True, flag])
+    assert "while processing 'descending'" in str(exc.value)
+
+
+def test_sort_descending_single_bool_applies_to_all(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 1, 2], "b": [3, 4, 5]}))
+    result = df.sort("a", "b", descending=True)
+    assert_equal_data(result, {"a": [2, 1, 1], "b": [5, 4, 3]})
+    result = df.sort("a", "b", descending=(flag for flag in [True, True]))
+    assert_equal_data(result, {"a": [2, 1, 1], "b": [5, 4, 3]})
