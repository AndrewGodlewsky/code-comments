index 6fe7b89..259347a 100644
--- a/src/narwhals/_utils.py
+++ b/src/narwhals/_utils.py
@@ -2294,6 +2294,24 @@ def extend_bool(
     return (value,) * n_match if isinstance(value, bool) else tuple(value)
 
 
+def validate_sort_flags(
+    value: bool | Iterable[bool],  # noqa: FBT001
+    n_keys: int,
+    *,
+    arg_name: str,
+) -> tuple[bool, ...]:
+    """Expand a bool or sequence of bools to one flag per sort key, validating it like Polars."""
+    flags = extend_bool(value, n_keys)
+    if len(flags) != n_keys:
+        msg = f"the length of `{arg_name}` ({len(flags)}) does not match the length of `by` ({n_keys})"
+        raise ValueError(msg)
+    for flag in flags:
+        if not isinstance(flag, bool):
+            msg = f"'{type(flag).__name__}' object is not an instance of 'bool' while processing '{arg_name}'"
+            raise TypeError(msg)
+    return flags
+
+
 class _NoDefault(Enum):
     # "borrowed" from
     # https://github.com/pandas-dev/pandas/blob/e7859983a814b1823cf26e3b491ae2fa3be47c53/pandas/_libs/lib.pyx#L2736-L2748
