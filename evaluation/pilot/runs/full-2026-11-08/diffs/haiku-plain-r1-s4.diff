 from __future__ import annotations
 
+import re
 from typing import Any
 
 import pytest
 
 import narwhals as nw
+import narwhals.stable.v1 as nw_v1
+import narwhals.stable.v2 as nw_v2
 from tests.utils import Constructor, assert_equal_data, skip_if_no_categorical_ordering
 
 
@@ -110,3 +113,38 @@ def test_sort_dictionary_pyarrow(
     assert_equal_data(result, {"c": expected})
     # ordering does not decode the output
     assert result.to_native().schema == native.schema
+
+
+def test_sort_descending_single_bool_applies_to_all(constructor: Constructor) -> None:
+    data = {"a": [1, 1, 2], "b": [1, 3, 2]}
+    df = nw.from_native(constructor(data))
+    result = df.sort("a", "b", descending=True)
+    assert_equal_data(result, {"a": [2, 1, 1], "b": [2, 3, 1]})
+
+
+def test_sort_descending_length_mismatch(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    msg = "the length of `descending` (1) does not match the length of `by` (2)"
+    with pytest.raises(ValueError, match=re.escape(msg)):
+        df.sort("a", "b", descending=[True])
+    empty_msg = "the length of `descending` (0) does not match the length of `by` (2)"
+    with pytest.raises(ValueError, match=re.escape(empty_msg)):
+        df.sort("a", "b", descending=[])
+
+
+@pytest.mark.parametrize("bad", ["abc", 1, 0, None])
+def test_sort_descending_not_bool(constructor: Constructor, bad: Any) -> None:
+    df = nw.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    with pytest.raises(TypeError, match="is not an instance of 'bool'"):
+        df.sort("a", "b", descending=[True, bad])
+
+
+@pytest.mark.parametrize("module", [nw_v1, nw_v2])
+def test_sort_descending_validation_stable(
+    constructor: Constructor, module: Any
+) -> None:
+    df = module.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    with pytest.raises(ValueError, match="does not match the length of `by`"):
+        df.sort("a", "b", descending=[True])
+    with pytest.raises(TypeError, match="is not an instance of 'bool'"):
+        df.sort("a", "b", descending=[True, "abc"])
