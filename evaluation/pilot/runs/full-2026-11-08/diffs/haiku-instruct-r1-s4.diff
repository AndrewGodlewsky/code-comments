     is_pandas_like_series,
 )
@@ -2294,6 +2295,36 @@ def extend_bool(
     return (value,) * n_match if isinstance(value, bool) else tuple(value)
 
 
+def _not_bool_error(value: object, name: str) -> TypeError:
+    return TypeError(
+        f"{type(value).__name__!r} object is not an instance of 'bool'\n"
+        f"while processing '{name}'"
+    )
+
+
+def _is_bool_flag(flag: object) -> bool:
+    return isinstance(flag, bool) or (is_numpy_scalar(flag) and flag.dtype == bool)
+
+
+def validate_bool_flags(
+    value: bool | Sequence[bool], n_keys: int, name: str
+) -> Sequence[bool]:
+    """Broadcast or validate a `descending` / `reverse` argument, as Polars does."""
+    if isinstance(value, bool):
+        return (value,) * n_keys
+    # NOTE: Polars only requires `len()`, which admits numpy arrays and strings.
+    if not hasattr(value, "__len__"):
+        raise _not_bool_error(value, name)
+    flags = tuple(value)
+    if len(flags) != n_keys:
+        msg = f"the length of `{name}` ({len(flags)}) does not match the length of `by` ({n_keys})"
+        raise ValueError(msg)
+    for flag in flags:
+        if not _is_bool_flag(flag):
+            raise _not_bool_error(flag, name)
+    return flags
+
+
 class _NoDefault(Enum):
