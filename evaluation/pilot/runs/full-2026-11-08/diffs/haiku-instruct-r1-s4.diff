diff --git a/tests/frame/sort_test.py b/tests/frame/sort_test.py
index 7d62693..9681012 100644
--- a/tests/frame/sort_test.py
+++ b/tests/frame/sort_test.py
@@ -1,7 +1,9 @@
 from __future__ import annotations
 
+import re
 from typing import Any
 
+import numpy as np
 import pytest
 
 import narwhals as nw
@@ -110,3 +112,40 @@ def test_sort_dictionary_pyarrow(
     assert_equal_data(result, {"c": expected})
     # ordering does not decode the output
     assert result.to_native().schema == native.schema
+
+
+@pytest.mark.parametrize(
+    ("descending", "exc", "match"),
+    [
+        (
+            [True],
+            ValueError,
+            re.escape("the length of `descending` (1) does not match the length of `by` (2)"),
+        ),
+        (["abc", True], TypeError, "is not an instance of 'bool'"),
+        ([1, 0], TypeError, "is not an instance of 'bool'"),
+        ([None, True], TypeError, "is not an instance of 'bool'"),
+        (1, TypeError, "is not an instance of 'bool'"),
+    ],
+)
+def test_sort_invalid_descending(
+    constructor: Constructor,
+    descending: Any,
+    exc: type[Exception],
+    match: str,
+) -> None:
+    df = nw.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    with pytest.raises(exc, match=match):
+        df.sort("a", "b", descending=descending)
+
+
+def test_sort_descending_single_bool(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2, 2], "b": [3, 4, 5]}))
+    result = df.sort("a", "b", descending=True)
+    assert_equal_data(result, {"a": [2, 2, 1], "b": [5, 4, 3]})
+
+
+def test_sort_descending_numpy_array(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2, 2], "b": [3, 4, 5]}))
+    result = df.sort("a", "b", descending=np.array([False, True]))
+    assert_equal_data(result, {"a": [1, 2, 2], "b": [3, 5, 4]})
