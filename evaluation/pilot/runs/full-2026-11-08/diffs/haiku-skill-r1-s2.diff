index ac50dd8..fa0dedc 100644
--- a/src/narwhals/_arrow/utils.py
+++ b/src/narwhals/_arrow/utils.py
@@ -33,7 +33,7 @@ if TYPE_CHECKING:
     )
     from narwhals._duration import IntervalUnit
     from narwhals.dtypes import DType
-    from narwhals.typing import IntoDType, PythonLiteral
+    from narwhals.typing import IntoDType, NonNestedLiteral, PythonLiteral
 
     # NOTE: stubs don't allow for `ChunkedArray[StructArray]`
     # Intended to represent the `.chunks` property storing `list[pa.StructArray]`
@@ -639,3 +639,28 @@ def list_sort(
         [not_sorted_part.column(idx), sorted_imploded], names=[idx, v]
     )
     return pa.concat_tables([imploded_by_idx, pass_through]).sort_by(idx).column(v)
+
+
+def list_contains(array: ChunkedArrayAny, item: NonNestedLiteral) -> ChunkedArrayAny:
+    # Per-row match counts come from a prefix sum over the flattened elements, so the
+    # cost is linear in the total number of elements, not in the number of rows.
+    arr = array.combine_chunks()
+    values = pc.list_flatten(arr)
+    if item is None:
+        matches = pc.is_null(values)
+    else:
+        matches = pc.fill_null(
+            pc.equal(values, pa.scalar(item, type=values.type)), pa.scalar(False)
+        )
+    prefix = pa.concat_arrays(
+        [pa.array([0], type=pa.int64()), pc.cumulative_sum(pc.cast(matches, pa.int64()))]
+    )
+    lengths = pc.fill_null(pc.list_value_length(arr), pa.scalar(0)).cast(pa.int64())
+    ends = pc.cumulative_sum(lengths)
+    starts = pc.subtract(ends, lengths)
+    counts = pc.subtract(prefix.take(ends), prefix.take(starts))
+    found = pc.greater(counts, pa.scalar(0, type=pa.int64()))
+    # A null list stays null, even though its (empty) span has no matches.
+    return pa.chunked_array(
+        [pc.if_else(pc.is_valid(arr), found, pa.scalar(None, type=pa.bool_()))]
+    )
