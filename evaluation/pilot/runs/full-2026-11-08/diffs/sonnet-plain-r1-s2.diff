 class ArrowSeriesNamespace(EagerSeriesNamespace["ArrowSeries", "ChunkedArrayAny"]): ...
 
 
+def list_contains(array: ChunkedArrayAny, item: Any) -> ChunkedArrayAny:
+    arr = array.combine_chunks()
+    flat = pc.list_flatten(arr)
+    hit = pc.is_null(flat) if item is None else pc.fill_null(pc.equal(flat, lit(item)), False)  # noqa: E501
+    hit_parents = pc.list_parent_indices(arr).filter(hit)
+    positions = pa.array(range(len(arr)), type=hit_parents.type)
+    found = pc.is_in(positions, value_set=hit_parents)
+    return pa.chunked_array([pc.if_else(pc.is_valid(arr), found, None)])
+
+
