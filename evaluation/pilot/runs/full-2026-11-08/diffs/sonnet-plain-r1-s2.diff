diff --git a/src/narwhals/_dask/expr_list.py b/src/narwhals/_dask/expr_list.py
new file mode 100644
index 0000000..0556866
--- /dev/null
+++ b/src/narwhals/_dask/expr_list.py
@@ -0,0 +1,48 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from narwhals._compliant import LazyExprNamespace
+from narwhals._compliant.any_namespace import ListNamespace
+from narwhals._utils import not_implemented
+
+if TYPE_CHECKING:
+    import dask.dataframe.dask_expr as dx
+    import pandas as pd
+
+    from narwhals._dask.expr import DaskExpr
+    from narwhals.typing import NonNestedLiteral
+
+
+class DaskExprListNamespace(LazyExprNamespace["DaskExpr"], ListNamespace["DaskExpr"]):
+    def contains(self, item: NonNestedLiteral) -> DaskExpr:
+        def _contains_partition(ser: pd.Series[object]) -> pd.Series[object]:
+            import pandas as pd
+
+            from narwhals._arrow.utils import list_contains
+
+            if not isinstance(ser.dtype, pd.ArrowDtype):
+                msg = "dask backed `Expr.list.contains` only supports pyarrow-backed list columns."
+                raise NotImplementedError(msg)
+            result = list_contains(ser.array._pa_array, item)  # type: ignore[attr-defined]
+            return pd.Series(
+                result, dtype=pd.ArrowDtype(result.type), index=ser.index, name=ser.name
+            )
+
+        def _contains(expr: dx.Series) -> dx.Series:
+            import pandas as pd
+
+            meta = pd.Series([], dtype="bool[pyarrow]", name=expr.name)
+            return expr.map_partitions(_contains_partition, meta=meta)
+
+        return self.compliant._with_callable(_contains)
+
+    get = not_implemented()
+    len = not_implemented()
+    unique = not_implemented()
+    min = not_implemented()
+    max = not_implemented()
+    mean = not_implemented()
+    median = not_implemented()
+    sum = not_implemented()
+    sort = not_implemented()
