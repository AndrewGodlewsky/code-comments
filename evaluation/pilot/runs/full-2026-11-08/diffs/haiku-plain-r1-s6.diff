+def _list_contains_comparable(inner: pa.DataType, item: Any) -> bool:
+    """Whether a non-null `item` can be compared with list items of type `inner`."""
+    if pa.types.is_null(inner):
+        return True
+    if isinstance(item, bool):
+        return pa.types.is_boolean(inner)
+    if isinstance(item, (int, float, Decimal)):
+        return (
+            pa.types.is_integer(inner)
+            or pa.types.is_floating(inner)
+            or pa.types.is_decimal(inner)
+        )
+    if isinstance(item, str):
+        return pa.types.is_string(inner) or pa.types.is_large_string(inner)
+    if isinstance(item, bytes):
+        return pa.types.is_binary(inner) or pa.types.is_large_binary(inner)
+    # pyarrow casts mismatched timestamp units silently, so require an exact type.
+    return inner == pa.scalar(item).type
+
+
