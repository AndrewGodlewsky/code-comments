+@pytest.mark.parametrize("empty", [False, True])
+def test_contains_incomparable_item_raises(
+    request: pytest.FixtureRequest,
+    constructor: Constructor,
+    values: list[Any],
+    dtype: nw.List,
+    item: Any,
+    *,
+    empty: bool,
+) -> None:
+    skip_or_xfail_unsupported(request, constructor)
+    if not any(
+        backend in str(constructor)
+        for backend in ("pandas", "pyarrow", "modin", "dask", "polars")
+    ):
+        pytest.skip(reason="Only pyarrow-backed and Polars backends are checked")
+    if "polars" in str(constructor) and isinstance(item, datetime):
+        # Polars 1.44 silently compares mismatched datetime units (and wrongly
+        # returns `False`), unlike the pyarrow-backed backends.
+        pytest.skip(reason="Polars doesn't raise on mismatched datetime precision")
+    df = nw.from_native(constructor({"i": [0, 1], "a": values})).lazy()
+    if empty:
+        df = df.filter(nw.col("i") > 1)
+    expr = nw.col("a").cast(dtype).list.contains(item)
+    with pytest.raises(InvalidOperationError, match="list.contains"):
+        df.select(expr).collect()
+
