+def check_sort_flags(
+    flags: bool | Sequence[bool], *, by: Collection[str], argument: str
+) -> None:
+    if isinstance(flags, bool) or not is_sequence_but_not_str(flags):
+        return
+    if len(flags) != len(by):
+        msg = f"the length of `{argument}` ({len(flags)}) does not match the length of `by` ({len(by)})"
+        raise ValueError(msg)
+    for flag in flags:
+        if not isinstance(flag, bool):
+            msg = f"'{type(flag).__name__}' object is not an instance of 'bool'\nwhile processing '{argument}'"
+            raise TypeError(msg)
+
+
 def check_column_names_are_unique(columns: Collection[str]) -> None:
     if len(columns) != len(set(columns)):
         from collections import Counter
