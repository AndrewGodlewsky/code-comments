+    def cast(self, dtypes: Mapping[str, IntoDType]) -> Self:
+        # NOTE: `with_columns` replaces a column via `set_column`, which makes its field
+        # nullable. Rebuilding the schema field by field keeps each cast column's
+        # nullability and leaves the other fields (and the schema metadata) untouched.
+        native = self.native
+        names = self.columns
+        fields = list(native.schema)
+        columns = list(native.columns)
+        for name, dtype in dtypes.items():
+            idx = names.index(name)
+            column = self.get_column(name).cast(dtype).native
+            fields[idx] = pa.field(name, column.type, nullable=fields[idx].nullable)
+            columns[idx] = column
+        schema = pa.schema(fields, metadata=native.schema.metadata)
+        return self._with_native(
+            pa.Table.from_arrays(columns, schema=schema), validate_column_names=False
+        )
+
