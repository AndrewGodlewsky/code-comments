diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..a983188
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+from datetime import datetime
+from typing import TYPE_CHECKING, Any
+
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError, NarwhalsError
+from tests.utils import assert_equal_data
+
+if TYPE_CHECKING:
+    from tests.utils import Constructor
+
+
+def _collected(df: nw.DataFrame[Any] | nw.LazyFrame[Any]) -> nw.DataFrame[Any]:
+    return df.collect() if isinstance(df, nw.LazyFrame) else df
+
+
+def test_cast_named_columns_only(constructor: Constructor) -> None:
+    data = {"a": [1, 2, 3], "b": [4, 5, 6], "c": [7.0, 8.0, 9.0]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({"c": nw.Int32, "a": nw.Float64})
+    assert result.collect_schema().names() == ["a", "b", "c"]
+    assert result.collect_schema()["a"] == nw.Float64
+    assert result.collect_schema()["b"] == df.collect_schema()["b"]
+    assert result.collect_schema()["c"] == nw.Int32
+    expected = {"a": [1.0, 2.0, 3.0], "b": [4, 5, 6], "c": [7, 8, 9]}
+    assert_equal_data(_collected(result), expected)
+
+
+def test_cast_empty_mapping(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": ["x", "y"]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({})
+    assert result.collect_schema() == df.collect_schema()
+    assert_equal_data(_collected(result), data)
+
+
+def test_cast_matches_with_columns(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": [3.0, 4.0], "c": ["x", "y"]}
+    df = nw.from_native(constructor(data))
+    mapping = {"a": nw.Float32, "c": nw.String}
+    expected = df.with_columns(nw.col(k).cast(v) for k, v in mapping.items())
+    result = df.cast(mapping)
+    assert result.collect_schema() == expected.collect_schema()
+    assert_equal_data(_collected(result), _collected(expected).to_dict(as_series=False))
+
+
+def test_cast_accepts_dtype_class(constructor: Constructor) -> None:
+    data = {"a": [datetime(2020, 1, 1), datetime(2021, 6, 1)], "b": [1, 2]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({"a": nw.Datetime, "b": nw.Int32})
+    expected = df.with_columns(
+        nw.col("a").cast(nw.Datetime), nw.col("b").cast(nw.Int32)
+    )
+    assert result.collect_schema() == expected.collect_schema()
+    assert isinstance(result.collect_schema()["a"], nw.Datetime)
+
+
+def test_cast_missing_column_raises(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(ColumnNotFoundError):
+        df.cast({"a": nw.Float64, "z": nw.Float64}).collect_schema()
+
+
+def test_cast_non_dtype_raises(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": "int64"})  # type: ignore[dict-item]
+
+
+def test_cast_unsupported_conversion_raises(
+    request: pytest.FixtureRequest, constructor: Constructor
+) -> None:
+    if "polars" not in str(constructor):
+        request.applymarker(
+            pytest.mark.xfail(reason="only Polars maps this error to NarwhalsError")
+        )
+    df = nw.from_native(constructor({"a": ["abc", "def"]}))
+    with pytest.raises(NarwhalsError):
+        _collected(df.cast({"a": nw.Int64}))
+
+
+def test_cast_pyarrow_keeps_schema_metadata_and_nullability() -> None:
+    pa = pytest.importorskip("pyarrow")
+    schema = pa.schema(
+        [
+            pa.field("a", pa.int64(), nullable=False, metadata={"k": "v"}),
+            pa.field("b", pa.int64(), nullable=False),
+            pa.field("c", pa.float64(), nullable=True),
+        ],
+        metadata={"table": "meta"},
+    )
+    native = pa.Table.from_arrays(
+        [pa.array([1, 2]), pa.array([3, None]), pa.array([1.0, 2.0])], schema=schema
+    )
+    result = nw.from_native(native).cast({"c": nw.Int32})
+    out = result.to_native()
+    assert out.schema.metadata == {b"table": b"meta"}
+    assert out.schema.field("a") == schema.field("a")
+    assert out.schema.field("b") == schema.field("b")
+    assert out.schema.field("c").type == pa.int32()
+    assert out.schema.field("c").nullable is True
+
+
+def test_cast_pyarrow_keeps_cast_column_nullability() -> None:
+    pa = pytest.importorskip("pyarrow")
+    schema = pa.schema([pa.field("a", pa.int64(), nullable=False)])
+    native = pa.Table.from_arrays([pa.array([1, 2])], schema=schema)
+    out = nw.from_native(native).cast({"a": nw.Float64}).to_native()
+    assert out.schema.field("a").type == pa.float64()
+    assert out.schema.field("a").nullable is False
