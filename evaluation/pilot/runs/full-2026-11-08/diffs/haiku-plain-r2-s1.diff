@@ -36,6 +36,15 @@ class DuckDBExprListNamespace(
         return self.compliant._with_elementwise(func)
 
     def contains(self, item: NonNestedLiteral) -> DuckDBExpr:
+        if item is None:
+            # `list_contains(x, NULL)` is always NULL in DuckDB.
+            def func(expr: Expression) -> Expression:
+                elem = col("_")
+                nulls = F("list_filter", expr, lambda_expr(elem, elem.isnull()))
+                return F("len", nulls) > lit(0)
+
+            return self.compliant._with_elementwise(func)
+
         return self.compliant._with_elementwise(
             lambda expr: F("list_contains", expr, lit(item))
         )
