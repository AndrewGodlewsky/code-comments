+def list_contains(array: ChunkedArrayAny, item: NonNestedLiteral) -> ChunkedArrayAny:
+    arr = array.combine_chunks()
+    flat = pc.list_flatten(arr)
+    if item is None:
+        matches = pc.is_null(flat)
+    elif isinstance(item, float) and math.isnan(item):
+        # NOTE: `equal` never matches NaN, but Polars does.
+        matches = pc.fill_null(pc.is_nan(flat), False)
+    else:
+        matches = pc.fill_null(pc.equal(flat, lit(item)), False)
+    # Each list's match count is a difference of two entries of this running total,
+    # so the whole computation is linear in the number of elements.
+    running = pa.concat_arrays(
+        [pa.array([0], pa.int64()), pc.cumulative_sum(pc.cast(matches, pa.int64()))]
+    )
+    lengths = pc.cast(pc.fill_null(pc.list_value_length(arr), 0), pa.int64())
+    ends = pc.cumulative_sum(lengths)
+    counts = pc.subtract(running.take(ends), running.take(pc.subtract(ends, lengths)))
+    has_item = pc.greater(counts, 0)
+    null_list = pc.is_null(arr)
+    return pa.chunked_array([pc.if_else(null_list, lit(None, pa.bool_()), has_item)])
+
