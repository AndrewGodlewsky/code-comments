+def _list_agg_partition(
+    series: pd.Series,
+    *,
+    func: Literal["min", "max", "mean", "approximate_median", "sum"],
+) -> pd.Series:
+    from narwhals._arrow.utils import list_agg
+
+    return apply_pyarrow_compute_to_series(series, partial(list_agg, func=func))
+
+
+def _list_sort_partition(
+    series: pd.Series, *, descending: bool, nulls_last: bool
+) -> pd.Series:
+    from narwhals._arrow.utils import list_sort
+
+    return apply_pyarrow_compute_to_series(
+        series, partial(list_sort, descending=descending, nulls_last=nulls_last)
+    )
+
+
 class DaskExprListNamespace(LazyExprNamespace["DaskExpr"], ListNamespace["DaskExpr"]):
+    def _partitionwise(self, func: Callable[[pd.Series], pd.Series]) -> DaskExpr:
+        def _call(expr: dx.Series) -> dx.Series:
+            ensure_pyarrow_backend(expr.dtype, self.compliant._implementation)
+            return expr.map_partitions(func, meta=func(expr._meta))
+
+        return self.compliant._with_callable(_call)
+
