+def _list_len_partition(series: pd.Series) -> pd.Series:
+    import pyarrow as pa  # ignore-banned-import
+
+    result = series.list.len().astype(pd.ArrowDtype(pa.uint32()))
+    result.name = series.name
+    return result
+
+
+def _list_get_partition(series: pd.Series, *, index: int) -> pd.Series:
+    result = series.list[index]
+    result.name = series.name
+    return result
+
