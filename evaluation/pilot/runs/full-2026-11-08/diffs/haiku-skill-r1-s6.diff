+_LIST_CONTAINS_KINDS: tuple[tuple[Callable[[pa.DataType], bool], ...], ...] = (
+    (pa.types.is_integer, pa.types.is_floating, pa.types.is_decimal),
+    (pa.types.is_string, pa.types.is_large_string),
+    (pa.types.is_binary, pa.types.is_large_binary),
+    (pa.types.is_date,),
+)
+
+
+def _list_contains_compatible(item_type: pa.DataType, inner: pa.DataType) -> bool:
+    if item_type == inner:
+        return True
+    if pa.types.is_timestamp(item_type) or pa.types.is_timestamp(inner):
+        # A Python datetime is microsecond precision and either naive or aware, so
+        # only a timestamp with the same unit and awareness can match it.
+        return (
+            pa.types.is_timestamp(item_type)
+            and pa.types.is_timestamp(inner)
+            and item_type.unit == inner.unit
+            and (item_type.tz is None) == (inner.tz is None)
+        )
+    return any(
+        is_item(item_type) and is_inner(inner)
+        for kind in _LIST_CONTAINS_KINDS
+        for is_item in kind
+        for is_inner in kind
+    )
+
+
+def _list_contains_error(
+    inner: pa.DataType, item: NonNestedLiteral
+) -> InvalidOperationError:
+    msg = (
+        f"`list.contains` cannot check for {inner} values "
+        f"with an item of type {type(item).__name__}."
+    )
+    return InvalidOperationError(msg)
+
+
+def _list_contains_item(item: NonNestedLiteral, inner: pa.DataType) -> pa.Scalar:
+    scalar = pa.scalar(item)
+    if not _list_contains_compatible(scalar.type, inner):
+        raise _list_contains_error(inner, item)
+    # Floats are rounded to the list's precision, as Polars does. Other numeric
+    # types are left to pyarrow's promotion, since casting `1.5` to int would
+    # truncate it to `1`.
+    return scalar.cast(inner) if pa.types.is_floating(inner) else scalar
+
