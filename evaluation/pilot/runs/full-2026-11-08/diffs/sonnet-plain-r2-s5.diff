+def _require_arrow(ser: pd.Series[Any], name: str) -> None:
+    import pandas as pd
+
+    if not isinstance(ser.dtype, pd.ArrowDtype):
+        msg = f"Only pyarrow-backed list columns are supported for `list.{name}` on Dask."
+        raise NotImplementedError(msg)
+
+
+def _wrap(ser: pd.Series[Any], result: Any) -> pd.Series[Any]:
+    import pandas as pd
+
+    return pd.Series(
+        result, dtype=pd.ArrowDtype(result.type), index=ser.index, name=ser.name
+    )
+
+
+def _len(ser: pd.Series[Any]) -> pd.Series[Any]:
+    import pyarrow as pa
+    import pyarrow.compute as pc
+
+    _require_arrow(ser, "len")
+    result = pc.cast(pc.list_value_length(ser.array._pa_array), pa.uint32())  # type: ignore[attr-defined]
+    return _wrap(ser, result)
+
+
+def _get(ser: pd.Series[Any], index: int) -> pd.Series[Any]:
+    _require_arrow(ser, "get")
+    return _wrap(ser, ser.list[index].array._pa_array)  # type: ignore[attr-defined]
+
+
+def _agg(ser: pd.Series[Any], func: str) -> pd.Series[Any]:
+    from narwhals._arrow.utils import list_agg
+
+    _require_arrow(ser, func)
+    return _wrap(ser, list_agg(ser.array._pa_array, func=func))  # type: ignore[attr-defined]
+
+
+def _sort(ser: pd.Series[Any], *, descending: bool, nulls_last: bool) -> pd.Series[Any]:
+    from narwhals._arrow.utils import list_sort
+
+    _require_arrow(ser, "sort")
+    result = list_sort(ser.array._pa_array, descending=descending, nulls_last=nulls_last)  # type: ignore[attr-defined]
+    return _wrap(ser, result)
+
