diff --git a/src/narwhals/_utils.py b/src/narwhals/_utils.py
index 6fe7b89..47fff1c 100644
--- a/src/narwhals/_utils.py
+++ b/src/narwhals/_utils.py
@@ -2294,6 +2294,32 @@ def extend_bool(
     return (value,) * n_match if isinstance(value, bool) else tuple(value)
 
 
+def validate_sort_flags(
+    value: bool | Sequence[bool],  # noqa: FBT001
+    n_keys: int,
+    arg_name: str,
+    /,
+) -> bool | tuple[bool, ...]:
+    """Validate `descending` / `reverse` up front, raising the same errors as Polars."""
+    if isinstance(value, bool):
+        return value
+    flags = tuple(value)
+    if len(flags) != n_keys:
+        msg = (
+            f"the length of `{arg_name}` ({len(flags)}) "
+            f"does not match the length of `by` ({n_keys})"
+        )
+        raise ValueError(msg)
+    for flag in flags:
+        if not isinstance(flag, bool):
+            msg = (
+                f"{type(flag).__name__!r} object is not an instance of 'bool'\n\n"
+                f"while processing '{arg_name}'"
+            )
+            raise TypeError(msg)
+    return flags
+
+
 class _NoDefault(Enum):
     # "borrowed" from
     # https://github.com/pandas-dev/pandas/blob/e7859983a814b1823cf26e3b491ae2fa3be47c53/pandas/_libs/lib.pyx#L2736-L2748
