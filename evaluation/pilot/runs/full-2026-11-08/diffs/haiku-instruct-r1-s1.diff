diff --git a/tests/expr_and_series/list/contains_test.py b/tests/expr_and_series/list/contains_test.py
index 6e56846..febe8e3 100644
--- a/tests/expr_and_series/list/contains_test.py
+++ b/tests/expr_and_series/list/contains_test.py
@@ -37,3 +37,72 @@ def test_contains_series(
     df = nw.from_native(constructor_eager(data), eager_only=True)
     result = df["a"].cast(nw.List(nw.Int32())).list.contains(2)
     assert_equal_data({"a": result}, expected)
+
+
+data_with_nulls = {"a": [[2, None], [1, None], [], None]}
+
+
+def test_contains_null_item(
+    request: pytest.FixtureRequest, constructor: Constructor
+) -> None:
+    if any(
+        backend in str(constructor)
+        for backend in ("dask", "modin", "cudf", "pyarrow", "pandas")
+    ):
+        request.applymarker(pytest.mark.xfail)
+    result = nw.from_native(constructor(data_with_nulls)).select(
+        found=nw.col("a").cast(nw.List(nw.Int32())).list.contains(2),
+        has_null=nw.col("a").cast(nw.List(nw.Int32())).list.contains(None),
+    )
+    expected_nulls = {
+        "found": [True, False, False, None],
+        "has_null": [True, True, False, None],
+    }
+    assert_equal_data(result, expected_nulls)
+
+
+def test_contains_null_item_series(
+    request: pytest.FixtureRequest, constructor_eager: ConstructorEager
+) -> None:
+    if any(
+        backend in str(constructor_eager)
+        for backend in ("modin", "cudf", "pyarrow", "pandas")
+    ):
+        request.applymarker(pytest.mark.xfail)
+    df = nw.from_native(constructor_eager(data_with_nulls), eager_only=True)
+    result = df["a"].cast(nw.List(nw.Int32())).list.contains(None)
+    assert_equal_data({"a": result}, {"a": [True, True, False, None]})
+
+
+def test_contains_null_item_struct(
+    request: pytest.FixtureRequest, constructor: Constructor
+) -> None:
+    if any(
+        backend in str(constructor)
+        for backend in ("dask", "modin", "cudf", "pyarrow", "pandas")
+    ):
+        request.applymarker(pytest.mark.xfail)
+    if "sqlframe" in str(constructor):
+        # SQLFrame builds dict values as MAP, not STRUCT, so the input can't be built
+        request.applymarker(pytest.mark.xfail)
+    data = {"a": [[{"x": 1}, None], [{"x": 2}], [], None]}
+    dtype = nw.List(nw.Struct({"x": nw.Int64()}))
+    result = nw.from_native(constructor(data)).select(
+        nw.col("a").cast(dtype).list.contains(None)
+    )
+    assert_equal_data(result, {"a": [True, False, False, None]})
+
+
+def test_contains_null_item_empty_frame(
+    request: pytest.FixtureRequest, constructor: Constructor
+) -> None:
+    if any(
+        backend in str(constructor)
+        for backend in ("dask", "modin", "cudf", "pyarrow", "pandas")
+    ):
+        request.applymarker(pytest.mark.xfail)
+    data = {"a": [[]]}
+    result = nw.from_native(constructor(data)).select(
+        nw.col("a").cast(nw.List(nw.Int32())).list.contains(None)
+    )
+    assert_equal_data(result, {"a": [False]})
