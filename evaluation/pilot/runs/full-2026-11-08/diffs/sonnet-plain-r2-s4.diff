+def _validate_bool_flags(
+    value: bool | Sequence[bool], n: int, name: str, other: str
+) -> bool | list[bool]:
+    if isinstance(value, bool):
+        return value
+    items = (
+        list(value)
+        if hasattr(value, "__iter__") and not isinstance(value, (str, bytes))
+        else [value]
+    )
+    for item in items:
+        if not isinstance(item, bool):
+            msg = (
+                f"'{type(item).__name__}' object is not an instance of 'bool'"
+                f"\n\nwhile processing '{name}'"
+            )
+            raise TypeError(msg)
+    if len(items) != n:
+        msg = f"the length of `{name}` ({len(items)}) does not match the length of `{other}` ({n})"
+        raise ValueError(msg)
+    return items
+
+
 class BaseFrame(Generic[_FrameT]):
     _compliant_frame: Any
     _level: Literal["full", "lazy", "interchange"]
@@ -316,6 +339,7 @@ class BaseFrame(Generic[_FrameT]):
         nulls_last: bool = False,
     ) -> Self:
         by = flatten([*flatten([by]), *more_by])
+        descending = _validate_bool_flags(descending, len(by), "descending", "by")
         return self._with_compliant(
             self._compliant_frame.sort(*by, descending=descending, nulls_last=nulls_last)
         )
