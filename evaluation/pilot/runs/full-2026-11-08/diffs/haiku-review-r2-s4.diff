+def dask_no_convert_string() -> AbstractContextManager[object]:
+    # Dask would otherwise convert object columns to pyarrow strings, which stringifies
+    # list columns when the frame is constructed.
+    try:
+        import dask
+    except ImportError:  # pragma: no cover
+        return nullcontext()
+    return dask.config.set({"dataframe.convert-string": False})
+
