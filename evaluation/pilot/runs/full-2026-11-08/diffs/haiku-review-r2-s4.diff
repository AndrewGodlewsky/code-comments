+def _not_bool_error(value: Any, name: str) -> TypeError:
+    type_name = "'None'" if value is None else f"'{type(value).__name__}' object"
+    msg = f"{type_name} is not an instance of 'bool'\nwhile processing '{name}'"
+    return TypeError(msg)
+
+
+def validate_bool_flags(
+    flags: bool | Iterable[bool],  # noqa: FBT001
+    n_keys: int,
+    *,
+    name: str,
+) -> bool | tuple[bool, ...]:
+    """Validate `descending` / `reverse` before they reach a backend.
+
+    Raises the same errors as Polars. A single `bool` is returned unchanged, so
+    backends keep their scalar fast paths (e.g. pandas `top_k` via `nlargest`).
+    """
+    if isinstance(flags, bool):
+        return flags
+    if isinstance(flags, (str, bytes)) or not isinstance(flags, Iterable):
+        raise _not_bool_error(flags, name)
+    values = tuple(flags)
+    if len(values) != n_keys:
+        msg = (
+            f"the length of `{name}` ({len(values)}) does not match "
+            f"the length of `by` ({n_keys})"
+        )
+        raise ValueError(msg)
+    for value in values:
+        is_bool = isinstance(value, bool) or (
+            is_numpy_scalar(value) and value.dtype.kind == "b"
+        )
+        if not is_bool:
+            raise _not_bool_error(value, name)
+    return values
+
+
