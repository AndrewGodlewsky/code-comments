diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..93c078c
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError
+from tests.utils import Constructor, assert_equal_data
+
+
+def test_cast(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2], "b": [3, 4], "c": [5, 6]}))
+    result = df.cast({"c": nw.Float64, "a": nw.Int32})
+    assert result.collect_schema()["c"] == nw.Float64
+    assert result.collect_schema()["a"] == nw.Int32
+    assert result.collect_schema().names() == ["a", "b", "c"]
+    assert_equal_data(result, {"a": [1, 2], "b": [3, 4], "c": [5, 6]})
+    assert df.cast({}).collect_schema().names() == ["a", "b", "c"]
+
+
+def test_cast_errors(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(ColumnNotFoundError):
+        df.cast({"z": nw.Int32})
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": "int64"})  # type: ignore[dict-item]
