+    def cast(self, dtypes: Mapping[str, DType | type[DType]]) -> Self:
+        # Replace each field in place, rather than going through `Table.cast`, so that
+        # schema metadata, untouched fields and nullability survive the cast.
+        native_frame = self.native
+        for name, dtype in dtypes.items():
+            index = native_frame.schema.get_field_index(name)
+            field = native_frame.schema.field(index)
+            try:
+                casted = self.get_column(name).cast(dtype).native
+            except pa.ArrowException as exc:
+                msg = f"Unable to cast column {name!r} to {dtype!r}."
+                raise InvalidOperationError(msg) from exc
+            new_field = pa.field(
+                name, casted.type, nullable=field.nullable, metadata=field.metadata
+            )
+            native_frame = native_frame.set_column(index, new_field, casted)
+        return self._with_native(native_frame, validate_column_names=False)
+
