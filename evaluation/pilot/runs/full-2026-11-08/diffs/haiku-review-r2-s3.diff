diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..f85fa18
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import pyarrow as pa
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError, NarwhalsError
+from tests.utils import assert_equal_data
+
+if TYPE_CHECKING:
+    from tests.utils import Constructor
+
+
+def test_cast(constructor: Constructor) -> None:
+    data = {"a": [1, 2, 3], "b": [4, 5, 6], "c": [7.0, 8.0, 9.0]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({"a": nw.Float64, "b": nw.Int32})
+    expected = df.with_columns(nw.col("a").cast(nw.Float64), nw.col("b").cast(nw.Int32))
+    assert result.collect_schema() == expected.collect_schema()
+    assert result.collect_schema().names() == ["a", "b", "c"]
+    expected_data = {"a": [1.0, 2.0, 3.0], "b": [4, 5, 6], "c": [7.0, 8.0, 9.0]}
+    assert_equal_data(result, expected_data)
+
+
+def test_cast_empty_mapping(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": [3.0, 4.0]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({})
+    assert result.collect_schema() == df.collect_schema()
+    assert_equal_data(result, data)
+
+
+def test_cast_dtype_class_and_instance(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": [3, 4]}
+    df = nw.from_native(constructor(data))
+    by_class = df.cast({"a": nw.Datetime, "b": nw.Float32})
+    by_instance = df.cast({"a": nw.Datetime(), "b": nw.Float32()})
+    assert by_class.collect_schema() == by_instance.collect_schema()
+
+
+def test_cast_missing_column(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(ColumnNotFoundError, match="zzz"):
+        df.cast({"zzz": nw.Float64})
+
+
+def test_cast_invalid_dtype(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": "int64"})  # type: ignore[dict-item]
+
+
+def test_cast_unsupported_by_backend(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": ["x", "y"]}))
+    if isinstance(df, nw.LazyFrame) and not df.implementation.is_polars():
+        # Lazy non-Polars backends raise their native error when collecting, and
+        # Narwhals does not wrap it there.
+        pytest.skip("native error is raised at collect time, not wrapped by Narwhals")
+    with pytest.raises(NarwhalsError):
+        result = df.cast({"a": nw.Int64})
+        if isinstance(result, nw.LazyFrame):
+            result.collect()
+
+
+def test_cast_pyarrow_preserves_schema() -> None:
+    schema = pa.schema(
+        [
+            pa.field("a", pa.int64(), nullable=False, metadata={b"k": b"v"}),
+            pa.field("b", pa.int32(), nullable=False),
+            pa.field("c", pa.string(), nullable=True, metadata={b"c": b"1"}),
+        ],
+        metadata={b"sm": b"1"},
+    )
+    native = pa.table({"a": [1, 2], "b": [3, 4], "c": ["x", None]}, schema=schema)
+    result = nw.from_native(native).cast({"a": nw.Float64}).to_native()
+    assert result.schema.metadata == {b"sm": b"1"}
+    assert result.schema.field("a") == pa.field(
+        "a", pa.float64(), nullable=False, metadata={b"k": b"v"}
+    )
+    assert result.schema.field("b") == schema.field("b")
+    assert result.schema.field("c") == schema.field("c")
+
+
+def test_cast_pyarrow_with_null_in_non_nullable_untouched_column() -> None:
+    schema = pa.schema(
+        [pa.field("a", pa.int64(), nullable=False), pa.field("b", pa.int32())]
+    )
+    native = pa.table({"a": [1, None], "b": [3, 4]}, schema=schema)
+    result = nw.from_native(native).cast({"b": nw.Float64}).to_native()
+    assert result.schema.field("a") == schema.field("a")
+    assert result.schema.field("b").type == pa.float64()
+    assert result.column("a").to_pylist() == [1, None]
