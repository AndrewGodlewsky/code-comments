new file mode 100644
index 0000000..7a79a15
--- /dev/null
+++ b/src/narwhals/_dask/expr_list.py
@@ -0,0 +1,51 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from narwhals._compliant import LazyExprNamespace
+from narwhals._compliant.any_namespace import ListNamespace
+from narwhals._pandas_like.utils import get_dtype_backend
+from narwhals._utils import Implementation, not_implemented
+
+if TYPE_CHECKING:
+    import dask.dataframe.dask_expr as dx
+
+    from narwhals._dask.expr import DaskExpr
+    from narwhals.typing import NonNestedLiteral
+
+
+class DaskExprListNamespace(LazyExprNamespace["DaskExpr"], ListNamespace["DaskExpr"]):
+    def contains(self, item: NonNestedLiteral) -> DaskExpr:
+        def _contains(expr: dx.Series) -> dx.Series:
+            import pandas as pd
+            import pyarrow as pa
+
+            from narwhals._arrow.utils import list_contains
+
+            def _partition(series: pd.Series) -> pd.Series:
+                backend = get_dtype_backend(series.dtype, Implementation.DASK)
+                if backend != "pyarrow":  # pragma: no cover
+                    msg = "Only pyarrow backend is currently supported for Dask lists."
+                    raise NotImplementedError(msg)
+                arr = series.array._pa_array  # type: ignore[attr-defined]
+                return pd.Series(
+                    pd.arrays.ArrowExtensionArray(list_contains(arr, item)),
+                    index=series.index,
+                    name=series.name,
+                )
+
+            return expr.map_partitions(
+                _partition, meta=(expr.name, pd.ArrowDtype(pa.bool_()))
+            )
+
+        return self.compliant._with_callable(_contains)
+
+    len = not_implemented()
+    unique = not_implemented()
+    get = not_implemented()
+    min = not_implemented()
+    max = not_implemented()
+    mean = not_implemented()
+    median = not_implemented()
+    sum = not_implemented()
+    sort = not_implemented()
