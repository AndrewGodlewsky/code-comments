diff --git a/tests/expr_and_series/list/contains_test.py b/tests/expr_and_series/list/contains_test.py
index 6e56846..4dcfaf7 100644
--- a/tests/expr_and_series/list/contains_test.py
+++ b/tests/expr_and_series/list/contains_test.py
@@ -37,3 +37,83 @@ def test_contains_series(
     df = nw.from_native(constructor_eager(data), eager_only=True)
     result = df["a"].cast(nw.List(nw.Int32())).list.contains(2)
     assert_equal_data({"a": result}, expected)
+
+
+null_data = {"a": [[1, None], None, [], [2, 3], [None]]}
+
+
+@pytest.mark.parametrize(
+    ("item", "expected_values"),
+    [(2, [False, None, False, True, False]), (None, [True, None, False, False, True])],
+)
+def test_contains_with_nulls_in_list(
+    request: pytest.FixtureRequest,
+    constructor: Constructor,
+    item: int | None,
+    expected_values: list[bool | None],
+) -> None:
+    if any(
+        backend in str(constructor)
+        for backend in ("dask", "modin", "cudf", "pyarrow", "pandas")
+    ):
+        request.applymarker(pytest.mark.xfail)
+    result = nw.from_native(constructor(null_data)).select(
+        nw.col("a").cast(nw.List(nw.Int32())).list.contains(item)
+    )
+    assert_equal_data(result, {"a": expected_values})
+
+
+def test_contains_none_only_empty_list(
+    request: pytest.FixtureRequest, constructor: Constructor
+) -> None:
+    if any(
+        backend in str(constructor)
+        for backend in ("dask", "modin", "cudf", "pyarrow", "pandas")
+    ):
+        request.applymarker(pytest.mark.xfail)
+    result = nw.from_native(constructor({"a": [[]]})).select(
+        nw.col("a").cast(nw.List(nw.Int32())).list.contains(None)
+    )
+    assert_equal_data(result, {"a": [False]})
+
+
+def test_contains_none_struct_inner(
+    request: pytest.FixtureRequest, constructor: Constructor
+) -> None:
+    if any(
+        backend in str(constructor)
+        for backend in ("dask", "modin", "cudf", "pyarrow", "pandas")
+    ):
+        request.applymarker(pytest.mark.xfail)
+    if "polars" in str(constructor):
+        # Polars itself raises for `list.contains(None)` on struct inner dtypes.
+        request.applymarker(pytest.mark.xfail)
+    if "sqlframe" in str(constructor):
+        # The constructor infers dict literals as MAP, which cannot be cast to STRUCT.
+        request.applymarker(pytest.mark.xfail)
+    dtype = nw.List(nw.Struct({"x": nw.Int32()}))
+    struct_data = {"a": [[{"x": 1}, None], None, [], [{"x": 1}]]}
+    result = nw.from_native(constructor(struct_data)).select(
+        nw.col("a").cast(dtype).list.contains(None)
+    )
+    assert_equal_data(result, {"a": [True, None, False, False]})
+
+
+@pytest.mark.parametrize(
+    ("item", "expected_values"),
+    [(2, [False, None, False, True, False]), (None, [True, None, False, False, True])],
+)
+def test_contains_series_with_nulls_in_list(
+    request: pytest.FixtureRequest,
+    constructor_eager: ConstructorEager,
+    item: int | None,
+    expected_values: list[bool | None],
+) -> None:
+    if any(
+        backend in str(constructor_eager)
+        for backend in ("modin", "cudf", "pyarrow", "pandas")
+    ):
+        request.applymarker(pytest.mark.xfail)
+    df = nw.from_native(constructor_eager(null_data), eager_only=True)
+    result = df["a"].cast(nw.List(nw.Int32())).list.contains(item)
+    assert_equal_data({"a": result}, {"a": expected_values})
