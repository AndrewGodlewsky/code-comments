diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..275c50f
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+
+from datetime import datetime
+from typing import TYPE_CHECKING
+
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError, NarwhalsError
+from tests.utils import assert_equal_data
+
+if TYPE_CHECKING:
+    from tests.utils import Constructor
+
+
+def test_cast(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": [3.0, 4.0], "c": ["x", "y"]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({"a": nw.Float64, "b": nw.Int32})
+    expected = df.with_columns(nw.col("a").cast(nw.Float64), nw.col("b").cast(nw.Int32))
+    assert result.collect_schema() == expected.collect_schema()
+    assert list(result.collect_schema()) == ["a", "b", "c"]
+    assert_equal_data(
+        result.select("a", "b", "c"),
+        {"a": [1.0, 2.0], "b": [3, 4], "c": ["x", "y"]},
+    )
+
+
+def test_cast_empty_mapping(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": ["x", "y"]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({})
+    assert result.collect_schema() == df.collect_schema()
+    assert_equal_data(result, data)
+
+
+def test_cast_dtype_class(constructor: Constructor) -> None:
+    data = {"t": [datetime(2020, 1, 1), datetime(2021, 6, 1)], "a": [1, 2]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({"t": nw.Datetime, "a": nw.Int32()})
+    expected = df.with_columns(
+        nw.col("t").cast(nw.Datetime), nw.col("a").cast(nw.Int32())
+    )
+    assert result.collect_schema() == expected.collect_schema()
+
+
+def test_cast_missing_column(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(ColumnNotFoundError):
+        df.cast({"z": nw.Float64})
+
+
+def test_cast_invalid_dtype(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": "int64"})  # type: ignore[dict-item]
+
+
+def test_cast_failure(request: pytest.FixtureRequest, constructor: Constructor) -> None:
+    if any(name in str(constructor) for name in ("duckdb", "sqlframe", "dask")):
+        request.applymarker(
+            pytest.mark.xfail(
+                reason="lazy backend only raises the native error at collect time"
+            )
+        )
+    df = nw.from_native(constructor({"a": [1, 2], "b": ["x", "y"]}))
+    with pytest.raises(NarwhalsError):
+        df.cast({"b": nw.Int64}).lazy().collect()
+
+
+def test_cast_pyarrow_preserves_schema() -> None:
+    pa = pytest.importorskip("pyarrow")
+    schema = pa.schema(
+        [
+            pa.field("a", pa.int64(), nullable=False, metadata={b"k": b"v"}),
+            pa.field("b", pa.int32(), nullable=False),
+            pa.field("c", pa.string(), nullable=True),
+        ],
+        metadata={b"sk": b"sv"},
+    )
+    # `b` is declared non-nullable but holds a null, and it is not cast.
+    native = pa.Table.from_arrays(
+        [pa.array([1, 2]), pa.array([1, None], pa.int32()), pa.array(["1", "2"])],
+        schema=schema,
+    )
+    result = nw.from_native(native).cast({"a": nw.Float64, "c": nw.Int64}).to_native()
+
+    assert result.schema.metadata == {b"sk": b"sv"}
+    assert result.schema.field("a").type == pa.float64()
+    assert result.schema.field("a").nullable is False
+    assert result.schema.field("a").metadata == {b"k": b"v"}
+    assert result.schema.field("b") == schema.field("b")
+    assert result.schema.field("c").type == pa.int64()
+    assert result.schema.field("c").nullable is True
+    assert result.column("c").to_pylist() == [1, 2]
