+        native = self.native
+        schema = native.schema
+        fields = list(schema)
+        arrays = list(native.columns)
+        for name, dtype in mapping.items():
+            idx = schema.get_field_index(name)
+            target = narwhals_to_native_dtype(dtype, self._version)
+            arrays[idx] = pc.cast(arrays[idx], target)
+            fields[idx] = fields[idx].with_type(target)
+        new_schema = pa.schema(fields, metadata=schema.metadata)
+        return self._with_native(
+            pa.Table.from_arrays(arrays, schema=new_schema), validate_column_names=False
+        )
