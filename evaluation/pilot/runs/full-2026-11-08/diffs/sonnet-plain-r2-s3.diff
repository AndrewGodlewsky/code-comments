+    def cast(self, mapping: Mapping[str, IntoDType]) -> Self:
+        """Cast columns to new data types.
+
+        Columns not named in `mapping` are left unchanged, and column order is kept.
+        Equivalent to `with_columns(nw.col(k).cast(v) for k, v in mapping.items())`.
+
+        Arguments:
+            mapping: Mapping of column names to the data types to cast them to.
+
+        Examples:
+            >>> import pyarrow as pa
+            >>> import narwhals as nw
+            >>> df_native = pa.table({"a": [1, 2], "b": [3, 4]})
+            >>> nw.from_native(df_native).cast({"a": nw.Float64}).schema
+            Schema({'a': Float64, 'b': Int64})
+        """
+        return super().cast(mapping)
