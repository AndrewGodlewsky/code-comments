diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..a71f6a4
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,79 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError, NarwhalsError
+from tests.utils import assert_equal_data
+
+if TYPE_CHECKING:
+    from tests.utils import Constructor
+
+data = {"a": [1, 2, 3], "b": [4.0, 5.0, 6.0], "c": ["7", "8", "9"]}
+
+
+def test_cast(constructor: Constructor) -> None:
+    df = nw.from_native(constructor(data))
+    mapping = {"a": nw.Float64, "c": nw.Int32()}
+    result = df.cast(mapping)
+    expected = df.with_columns(nw.col(k).cast(v) for k, v in mapping.items())
+    assert result.collect_schema() == expected.collect_schema()
+    expected_data = {"a": [1.0, 2.0, 3.0], "b": [4.0, 5.0, 6.0], "c": [7, 8, 9]}
+    assert_equal_data(result, expected_data)
+
+
+def test_cast_keeps_other_columns_and_order(constructor: Constructor) -> None:
+    df = nw.from_native(constructor(data))
+    result = df.cast({"b": nw.Int64})
+    assert result.collect_schema().names() == ["a", "b", "c"]
+    assert result.collect_schema()["a"] == df.collect_schema()["a"]
+    assert result.collect_schema()["c"] == df.collect_schema()["c"]
+
+
+def test_cast_empty_mapping(constructor: Constructor) -> None:
+    df = nw.from_native(constructor(data))
+    assert_equal_data(df.cast({}), data)
+
+
+def test_cast_missing_column(constructor: Constructor) -> None:
+    df = nw.from_native(constructor(data))
+    with pytest.raises(ColumnNotFoundError):
+        df.cast({"z": nw.Int64})
+
+
+def test_cast_invalid_dtype(constructor: Constructor) -> None:
+    df = nw.from_native(constructor(data))
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": "int64"})  # type: ignore[dict-item]
+
+
+def test_cast_unsupported_conversion(constructor: Constructor) -> None:
+    if "polars" not in str(constructor):
+        pytest.skip("native conversion errors are only translated for Polars")
+    df = nw.from_native(constructor({"a": ["x", "y"]}))
+    with pytest.raises(NarwhalsError):
+        df.cast({"a": nw.Int64}).collect()
+
+
+def test_cast_pyarrow_keeps_schema() -> None:
+    pa = pytest.importorskip("pyarrow")
+    schema = pa.schema(
+        [
+            pa.field("a", pa.int64(), nullable=False, metadata={"k": "v"}),
+            pa.field("b", pa.string()),
+            pa.field("c", pa.int64(), nullable=False),
+        ],
+        metadata={"table": "meta"},
+    )
+    native = pa.Table.from_arrays(
+        [pa.array([1, 2]), pa.array(["3", "4"]), pa.array([None, 6])], schema=schema
+    )
+    result = nw.from_native(native).cast({"a": nw.Float64, "b": nw.Int64}).to_native()
+    assert result.schema.metadata == schema.metadata
+    assert result.schema.field("a").type == pa.float64()
+    assert not result.schema.field("a").nullable
+    assert result.schema.field("c") == schema.field("c")
+    assert result.schema.field("b").type == pa.int64()
+    assert result.schema.field("b").nullable
