     from narwhals.dtypes import DType
-    from narwhals.typing import IntoDType, PythonLiteral
+    from narwhals.typing import IntoDType, NonNestedLiteral, PythonLiteral
 
     # NOTE: stubs don't allow for `ChunkedArray[StructArray]`
     # Intended to represent the `.chunks` property storing `list[pa.StructArray]`
@@ -639,3 +639,27 @@ def list_sort(
         [not_sorted_part.column(idx), sorted_imploded], names=[idx, v]
     )
     return pa.concat_tables([imploded_by_idx, pass_through]).sort_by(idx).column(v)
+
+
+def list_contains(array: ChunkedArrayAny, item: NonNestedLiteral) -> ChunkedArrayAny:
+    # Linear in the number of list elements: count matches over the child buffer, then
+    # read each list's count from its offsets. A group-by on parent indices would need
+    # a sort to restore row order. Elements under null lists are counted but never read.
+    list_array = array.combine_chunks()
+    values = list_array.values
+    if item is None:
+        matches = pc.is_null(values)
+    else:
+        matches = pc.fill_null(
+            pc.equal(values, pa.scalar(item, type=values.type)), False
+        )
+    running = pa.concat_arrays(
+        [pa.array([0], type=pa.int64()), pc.cumulative_sum(matches.cast(pa.int64()))]
+    )
+    offsets = list_array.offsets
+    counts = pc.subtract(pc.take(running, offsets[1:]), pc.take(running, offsets[:-1]))
+    result = pc.greater(counts, lit(0))
+    null_bool = pa.scalar(None, type=pa.bool_())
+    return pa.chunked_array(
+        [pc.if_else(pc.is_valid(list_array), result, null_bool)], type=pa.bool_()
+    )
