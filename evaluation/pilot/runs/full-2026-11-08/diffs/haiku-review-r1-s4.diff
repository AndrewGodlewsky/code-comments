diff --git a/tests/frame/sort_test.py b/tests/frame/sort_test.py
index 7d62693..7669a93 100644
--- a/tests/frame/sort_test.py
+++ b/tests/frame/sort_test.py
@@ -1,10 +1,12 @@
 from __future__ import annotations
 
+import re
 from typing import Any
 
 import pytest
 
 import narwhals as nw
+import narwhals.stable.v1 as nw_v1
 from tests.utils import Constructor, assert_equal_data, skip_if_no_categorical_ordering
 
 
@@ -110,3 +112,40 @@ def test_sort_dictionary_pyarrow(
     assert_equal_data(result, {"c": expected})
     # ordering does not decode the output
     assert result.to_native().schema == native.schema
+
+
+@pytest.mark.parametrize(
+    ("descending", "expected_len"),
+    [([True], 1), ([True, False, True], 3)],
+)
+def test_sort_descending_length_mismatch(
+    constructor: Constructor, descending: list[bool], expected_len: int
+) -> None:
+    df = nw.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    msg = (
+        f"the length of `descending` ({expected_len}) does not match "
+        "the length of `by` (2)"
+    )
+    with pytest.raises(ValueError, match=re.escape(msg)):
+        df.sort("a", "b", descending=descending)
+
+
+@pytest.mark.parametrize("bad", ["abc", 1, 0, None])
+def test_sort_descending_not_bool(constructor: Constructor, bad: Any) -> None:
+    df = nw.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    with pytest.raises(TypeError, match=r"is not an instance of 'bool'") as exc_info:
+        df.sort("a", "b", descending=[True, bad])
+    assert "while processing 'descending'" in str(exc_info.value)
+
+
+def test_sort_descending_single_bool_applies_to_all(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 1, 2], "b": [1, 2, 3]}))
+    result = df.sort("a", "b", descending=True)
+    assert_equal_data(result, {"a": [2, 1, 1], "b": [3, 2, 1]})
+
+
+def test_sort_descending_validated_stable_v1(constructor: Constructor) -> None:
+    df = nw_v1.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    msg = "the length of `descending` (1) does not match the length of `by` (2)"
+    with pytest.raises(ValueError, match=re.escape(msg)):
+        df.sort("a", "b", descending=[True])
