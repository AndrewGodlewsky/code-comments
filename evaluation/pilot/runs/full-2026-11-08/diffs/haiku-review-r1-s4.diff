index 6fe7b89..5e198fe 100644
--- a/src/narwhals/_utils.py
+++ b/src/narwhals/_utils.py
@@ -700,6 +700,25 @@ def flatten(args: Any) -> list[Any]:
     return list(args[0] if (len(args) == 1 and _is_iterable(args[0])) else args)
 
 
+def validate_sort_flags(flags: bool | Sequence[bool], n_keys: int, *, name: str) -> None:
+    """Raise the same errors as Polars for invalid `descending` / `reverse` flags."""
+    if isinstance(flags, bool):
+        return
+    if len(flags) != n_keys:
+        msg = (
+            f"the length of `{name}` ({len(flags)}) does not match "
+            f"the length of `by` ({n_keys})"
+        )
+        raise ValueError(msg)
+    for flag in flags:
+        if not isinstance(flag, bool):
+            msg = (
+                f"'{type(flag).__name__}' object is not an instance of 'bool'\n"
+                f"while processing '{name}'"
+            )
+            raise TypeError(msg)
+
+
 def tupleify(arg: Any) -> Any:
     if not isinstance(arg, (list, tuple)):  # pragma: no cover
         return (arg,)
