+from collections.abc import Sequence as _Seq  # noqa: E402
+
+
+def _validate_bool_flags(flags: Any, name: str, n_by: int) -> None:
+    if isinstance(flags, (str, bytes)) or not isinstance(flags, (bool, _Seq)):
+        items: Sequence[Any] = [flags]
+    elif isinstance(flags, bool):
+        return
+    else:
+        items = flags
+        if len(items) != n_by:
+            msg = f"the length of `{name}` ({len(items)}) does not match the length of `by` ({n_by})"
+            raise ValueError(msg)
+    for item in items:
+        if not isinstance(item, bool):
+            msg = f"{type(item).__name__!r} object is not an instance of 'bool'\n\nwhile processing {name!r}"
+            raise TypeError(msg)
+
+
 class BaseFrame(Generic[_FrameT]):
     _compliant_frame: Any
     _level: Literal["full", "lazy", "interchange"]
@@ -314,6 +333,7 @@ class BaseFrame(Generic[_FrameT]):
         nulls_last: bool = False,
     ) -> Self:
         by = flatten([*flatten([by]), *more_by])
+        _validate_bool_flags(descending, "descending", len(by))
         return self._with_compliant(
             self._compliant_frame.sort(*by, descending=descending, nulls_last=nulls_last)
         )
@@ -322,6 +342,7 @@ class BaseFrame(Generic[_FrameT]):
         self, k: int, *, by: str | Iterable[str], reverse: bool | Sequence[bool] = False
     ) -> Self:
         flatten_by = flatten([by])
