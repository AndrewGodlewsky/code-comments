+def ensure_pyarrow_backend(native_dtype: Any, implementation: Implementation) -> None:
+    if get_dtype_backend(native_dtype, implementation) != "pyarrow":  # pragma: no cover
+        msg = "Only pyarrow backend is currently supported."
+        raise NotImplementedError(msg)
+
+
+def apply_pyarrow_compute_to_series(
+    native: pd.Series, pc_func: Callable[[pa.ChunkedArray], pa.ChunkedArray]
+) -> pd.Series:
+    result_arr = pc_func(native.array._pa_array)  # type: ignore[attr-defined]
+    return pd.Series(
+        result_arr,
+        index=native.index,
+        name=native.name,
+        dtype=pd.ArrowDtype(result_arr.type),
+    )
+
+
