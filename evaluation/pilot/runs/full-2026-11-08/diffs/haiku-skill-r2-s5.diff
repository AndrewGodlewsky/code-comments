diff --git a/src/narwhals/_dask/expr_list.py b/src/narwhals/_dask/expr_list.py
index d6e28b6..ed8d157 100644
--- a/src/narwhals/_dask/expr_list.py
+++ b/src/narwhals/_dask/expr_list.py
@@ -1,5 +1,6 @@
 from __future__ import annotations
 
+from functools import partial
 from typing import TYPE_CHECKING
 
 import pandas as pd
@@ -9,8 +10,12 @@ from narwhals._compliant.any_namespace import ListNamespace
 from narwhals._utils import not_implemented
 
 if TYPE_CHECKING:
+    from collections.abc import Callable
+    from typing import Literal
+
     import dask.dataframe.dask_expr as dx
 
+    from narwhals._arrow.typing import ChunkedArrayAny
     from narwhals._dask.expr import DaskExpr
     from narwhals.typing import NonNestedLiteral
 
@@ -29,19 +34,84 @@ def _list_contains(series: pd.Series, item: NonNestedLiteral) -> pd.Series:
     )
 
 
+def _apply_arrow_list_func(
+    series: pd.Series, arrow_func: Callable[[ChunkedArrayAny], ChunkedArrayAny]
+) -> pd.Series:
+    result = arrow_func(series.array._pa_array)
+    return pd.Series(
+        result,
+        index=series.index,
+        name=series.name,
+        dtype=pd.ArrowDtype(result.type),
+    )
+
+
+def _list_len(array: ChunkedArrayAny) -> ChunkedArrayAny:
+    import pyarrow as pa
+    import pyarrow.compute as pc
+
+    return pc.list_value_length(array).cast(pa.uint32())
+
+
+def _list_get(array: ChunkedArrayAny, index: int) -> ChunkedArrayAny:
+    import pyarrow.compute as pc
+
+    return pc.list_element(array, index)
+
+
 class DaskExprListNamespace(LazyExprNamespace["DaskExpr"], ListNamespace["DaskExpr"]):
+    def _with_arrow_func(
+        self, arrow_func: Callable[[ChunkedArrayAny], ChunkedArrayAny]
+    ) -> DaskExpr:
+        def _call(expr: dx.Series) -> dx.Series:
+            # Checked here rather than per partition: Dask wraps errors raised during
+            # metadata inference in a ValueError.
+            if "pyarrow" not in str(expr.dtype):
+                msg = "Series must be of PyArrow List type to support list namespace."
+                raise TypeError(msg)
+            return expr.map_partitions(_apply_arrow_list_func, arrow_func=arrow_func)
+
+        return self.compliant._with_callable(_call)
+
     def contains(self, item: NonNestedLiteral) -> DaskExpr:
         def _contains(expr: dx.Series) -> dx.Series:
             return expr.map_partitions(_list_contains, item=item)
 
         return self.compliant._with_callable(_contains)
 
-    len = not_implemented()
+    def len(self) -> DaskExpr:
+        return self._with_arrow_func(_list_len)
+
+    def get(self, index: int) -> DaskExpr:
+        return self._with_arrow_func(partial(_list_get, index=index))
+
+    def min(self) -> DaskExpr:
+        return self._agg("min")
+
+    def max(self) -> DaskExpr:
+        return self._agg("max")
+
+    def mean(self) -> DaskExpr:
+        return self._agg("mean")
+
+    def median(self) -> DaskExpr:
+        return self._agg("approximate_median")
+
+    def sum(self) -> DaskExpr:
+        return self._agg("sum")
+
+    def _agg(
+        self, func: Literal["min", "max", "mean", "approximate_median", "sum"]
+    ) -> DaskExpr:
+        from narwhals._arrow.utils import list_agg
+
+        return self._with_arrow_func(partial(list_agg, func=func))
+
     unique = not_implemented()
-    get = not_implemented()
-    min = not_implemented()
-    max = not_implemented()
-    mean = not_implemented()
-    median = not_implemented()
-    sum = not_implemented()
-    sort = not_implemented()
+
+    def sort(self, *, descending: bool, nulls_last: bool) -> DaskExpr:
+        from narwhals._arrow.utils import list_sort
+
+        return self._with_arrow_func(
+            partial(list_sort, descending=descending, nulls_last=nulls_last)
+        )
