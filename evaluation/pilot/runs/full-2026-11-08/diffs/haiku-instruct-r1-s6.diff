+def raise_if_incomparable_item(value_type: pa.DataType, item: NonNestedLiteral) -> None:
+    scalar = lit(item)
+    msg = (
+        f"Unable to check for item of type {type(item).__name__} "
+        f"in list values of type {value_type}."
+    )
+    # Unlike Polars, pyarrow silently casts between timestamp units.
+    if (
+        pa.types.is_timestamp(value_type)
+        and pa.types.is_timestamp(scalar.type)
+        and value_type.unit != scalar.type.unit
+    ):
+        raise InvalidOperationError(msg)
+    try:
+        # Dispatch fails on an empty array too, so empty frames raise as well.
+        pc.equal(pa.array([], type=value_type), scalar)
+    except (pa.ArrowInvalid, pa.ArrowNotImplementedError, pa.ArrowTypeError) as exc:
+        raise InvalidOperationError(msg) from exc
+
