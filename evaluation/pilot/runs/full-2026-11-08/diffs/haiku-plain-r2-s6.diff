+def _is_numeric_type(dtype: pa.DataType) -> bool:
+    return (
+        pa.types.is_integer(dtype)
+        or pa.types.is_floating(dtype)
+        or pa.types.is_decimal(dtype)
+    )
+
+
+def _is_string_type(dtype: pa.DataType) -> bool:
+    return pa.types.is_string(dtype) or pa.types.is_large_string(dtype)
+
+
+def _is_comparable_to_list_items(inner: pa.DataType, item_type: pa.DataType) -> bool:
+    # A list of only nulls has no value to match, so any item is simply not found.
+    if (
+        pa.types.is_null(inner)
+        or (_is_numeric_type(inner) and _is_numeric_type(item_type))
+        or (_is_string_type(inner) and _is_string_type(item_type))
+    ):
+        return True
+    if pa.types.is_timestamp(inner) and pa.types.is_timestamp(item_type):
+        return inner.unit == item_type.unit and (inner.tz is None) == (
+            item_type.tz is None
+        )
+    return inner.equals(item_type)
+
