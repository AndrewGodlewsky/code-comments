+def _is_pyarrow_list_constructor(constructor: Constructor) -> bool:
+    return "pyarrow" in str(constructor) or "dask" in str(constructor)
+
+
+@pytest.mark.parametrize(
+    ("values", "inner", "item"),
+    [
+        ([[1, 2], [3]], nw.Int64(), True),
+        ([[1, 2], [3]], nw.Int64(), "x"),
+        ([[True], [False]], nw.Boolean(), 1),
+        ([["x"], ["y"]], nw.String(), 1),
+        ([[datetime(2020, 1, 1)]], nw.Datetime("ns"), datetime(2020, 1, 1)),
+        (
+            [[datetime(2020, 1, 1)]],
+            nw.Datetime("us"),
+            datetime(2020, 1, 1, tzinfo=timezone.utc),
+        ),
+    ],
+)
+@pytest.mark.parametrize("empty", [False, True])
+def test_contains_incompatible_item_raises(
+    request: pytest.FixtureRequest,
+    constructor: Constructor,
+    values: list[Any],
+    inner: DType,
+    item: Any,
+    empty: bool,
+) -> None:
+    skip_or_xfail_unsupported(request, constructor)
+    if not _is_pyarrow_list_constructor(constructor):
+        pytest.skip(reason="Only pyarrow-backed lists raise on incompatible items")
+    df = nw.from_native(constructor({"a": values}))
+    if empty:
+        df = df.filter(nw.col("a").is_null())
+    expr = nw.col("a").cast(nw.List(inner)).list.contains(item)
+    with pytest.raises(InvalidOperationError, match="cannot check for"):
+        maybe_collect(df.select(expr))
+
