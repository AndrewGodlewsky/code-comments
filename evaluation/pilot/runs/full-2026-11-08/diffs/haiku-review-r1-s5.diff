diff --git a/src/narwhals/_dask/expr_list.py b/src/narwhals/_dask/expr_list.py
index 5e43d1c..9778252 100644
--- a/src/narwhals/_dask/expr_list.py
+++ b/src/narwhals/_dask/expr_list.py
@@ -10,6 +10,9 @@ from narwhals._compliant.any_namespace import ListNamespace
 from narwhals._utils import Implementation, not_implemented
 
 if TYPE_CHECKING:
+    from collections.abc import Callable
+    from typing import Any, Literal
+
     import dask.dataframe.dask_expr as dx
 
     from narwhals._dask.expr import DaskExpr
@@ -31,21 +34,80 @@ def _list_contains(
     )
 
 
+def _raise_if_not_pyarrow_list(native: dx.Series) -> None:
+    from narwhals._arrow.utils import is_list
+    from narwhals._pandas_like.utils import is_dtype_pyarrow
+
+    if not (is_dtype_pyarrow(native.dtype) and is_list(native.dtype.pyarrow_dtype)):
+        msg = "Only pyarrow-backed list columns are currently supported on dask."
+        raise NotImplementedError(msg)
+
+
 class DaskExprListNamespace(LazyExprNamespace["DaskExpr"], ListNamespace["DaskExpr"]):
+    def _apply(self, pc_func: Callable[[Any], Any]) -> DaskExpr:
+        from narwhals._pandas_like.utils import apply_pyarrow_compute_func
+
+        version = self.compliant._version
+
+        def _call(expr: dx.Series) -> dx.Series:
+            _raise_if_not_pyarrow_list(expr)
+            return expr.map_partitions(
+                apply_pyarrow_compute_func,
+                pc_func=pc_func,
+                implementation=Implementation.DASK,
+                version=version,
+            )
+
+        return self.compliant._with_callable(_call)
+
     def contains(self, item: NonNestedLiteral) -> DaskExpr:
         version = self.compliant._version
 
         def _contains(expr: dx.Series) -> dx.Series:
+            _raise_if_not_pyarrow_list(expr)
             return expr.map_partitions(_list_contains, item=item, version=version)
 
         return self.compliant._with_callable(_contains)
 
-    get = not_implemented()
-    len = not_implemented()
+    def len(self) -> DaskExpr:
+        import pyarrow as pa
+        import pyarrow.compute as pc
+
+        # Match the `UInt32` result of the pandas-like backends.
+        return self._apply(lambda array: pc.list_value_length(array).cast(pa.uint32()))
+
+    def get(self, index: int) -> DaskExpr:
+        import pyarrow.compute as pc
+
+        return self._apply(lambda array: pc.list_element(array, index))
+
+    def min(self) -> DaskExpr:
+        return self._agg("min")
+
+    def max(self) -> DaskExpr:
+        return self._agg("max")
+
+    def mean(self) -> DaskExpr:
+        return self._agg("mean")
+
+    def median(self) -> DaskExpr:
+        return self._agg("approximate_median")
+
+    def sum(self) -> DaskExpr:
+        return self._agg("sum")
+
+    def _agg(
+        self, func: Literal["min", "max", "mean", "approximate_median", "sum"]
+    ) -> DaskExpr:
+        from narwhals._arrow.utils import list_agg
+
+        return self._apply(partial(list_agg, func=func))
+
+    def sort(self, *, descending: bool, nulls_last: bool) -> DaskExpr:
+        from narwhals._arrow.utils import list_sort
+
+        return self._apply(
+            partial(list_sort, descending=descending, nulls_last=nulls_last)
+        )
+
     unique = not_implemented()
