         to_drop = parse_columns_to_drop(self, columns, strict=strict)
         return self._with_native(self.native.drop(to_drop), validate_column_names=False)
 
+    def cast(self, dtypes: Mapping[str, IntoDType]) -> Self:
+        # `with_columns` would make a replaced field nullable, so set each cast column's
+        # field explicitly to keep its original nullability.
+        native_frame = self.native
+        for name, dtype in dtypes.items():
+            index = self.columns.index(name)
+            nullable = native_frame.schema.field(index).nullable
+            try:
+                column = self.get_column(name).cast(dtype).native
+            except (
+                pa.ArrowInvalid,
+                pa.ArrowNotImplementedError,
+                pa.ArrowTypeError,
+            ) as exc:
+                msg = f"Unable to cast column {name!r} to {dtype}: {exc}"
+                raise InvalidOperationError(msg) from exc
+            field = pa.field(name, column.type, nullable=nullable)
+            native_frame = native_frame.set_column(index, field, column)
+        return self._with_native(native_frame, validate_column_names=False)
+
     def drop_nulls(self, subset: Sequence[str] | None) -> Self:
         if subset is None:
             return self._with_native(self.native.drop_null(), validate_column_names=False)
