diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..5b0a9ce
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,79 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError, NarwhalsError
+from tests.utils import assert_equal_data
+
+if TYPE_CHECKING:
+    from tests.utils import Constructor
+
+pytest.importorskip("pyarrow")
+
+import pyarrow as pa  # noqa: E402
+
+DATA = {"a": [1, 2, 3], "b": [4.0, 5.0, 6.0], "c": ["x", "y", "z"]}
+
+
+@pytest.mark.parametrize("dtype", [nw.Float64, nw.Float64()])
+def test_cast_matches_with_columns(constructor: Constructor, dtype: Any) -> None:
+    df = nw.from_native(constructor(DATA))
+    mapping = {"a": dtype, "b": nw.Int32}
+    result = df.cast(mapping)
+    expected = df.with_columns(nw.col(k).cast(v) for k, v in mapping.items())
+    assert result.collect_schema() == expected.collect_schema()
+    assert result.collect_schema().names() == ["a", "b", "c"]
+    expected_data = {"a": [1.0, 2.0, 3.0], "b": [4, 5, 6], "c": ["x", "y", "z"]}
+    assert_equal_data(result, expected_data)
+
+
+def test_cast_empty_mapping(constructor: Constructor) -> None:
+    df = nw.from_native(constructor(DATA))
+    assert_equal_data(df.cast({}), DATA)
+
+
+def test_cast_missing_column(constructor: Constructor) -> None:
+    df = nw.from_native(constructor(DATA))
+    with pytest.raises(ColumnNotFoundError, match="zz"):
+        df.cast({"zz": nw.Int64}).collect_schema()
+
+
+def test_cast_invalid_dtype(constructor: Constructor) -> None:
+    df = nw.from_native(constructor(DATA))
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": "int64"})  # type: ignore[dict-item]
+
+
+def test_cast_unsupported_raises_narwhals_error() -> None:
+    pl = pytest.importorskip("polars")
+    with pytest.raises(NarwhalsError):
+        nw.from_native(pl.DataFrame({"s": ["a"]})).cast({"s": nw.Int64})
+    with pytest.raises(NarwhalsError):
+        nw.from_native(pl.LazyFrame({"s": ["a"]})).cast({"s": nw.Int64}).collect()
+    table = pa.table({"s": ["a"]})
+    with pytest.raises(NarwhalsError):
+        nw.from_native(table).cast({"s": nw.Int64})
+
+
+def test_cast_pyarrow_keeps_metadata_and_nullability() -> None:
+    schema = pa.schema(
+        [
+            pa.field("a", pa.int64(), nullable=False, metadata={"fa": "1"}),
+            pa.field("b", pa.int64(), nullable=False, metadata={"fb": "2"}),
+            pa.field("c", pa.string(), nullable=True),
+        ],
+        metadata={"table": "meta"},
+    )
+    table = pa.Table.from_arrays(
+        [pa.array([1, 2]), pa.array([None, 4]), pa.array(["x", "y"])], schema=schema
+    )
+    out = nw.from_native(table).cast({"a": nw.Float64}).to_native()
+    assert out.schema.metadata == {b"table": b"meta"}
+    assert out.schema.field("a").type == pa.float64()
+    assert out.schema.field("a").nullable is False
+    assert out.schema.field("b") == schema.field("b")
+    assert out.schema.field("c") == schema.field("c")
+    assert out.column("b").to_pylist() == [None, 4]
