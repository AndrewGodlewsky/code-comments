diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..9926cce
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,112 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import pyarrow as pa
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError, NarwhalsError
+from tests.utils import assert_equal_data
+
+if TYPE_CHECKING:
+    from narwhals.typing import IntoDType
+    from tests.utils import Constructor
+
+
+def test_cast_matches_with_columns(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": [3, 4], "c": [0.5, 1.5]}
+    df = nw.from_native(constructor(data))
+    mapping = {"a": nw.Float64, "b": nw.Int32}
+    result = df.cast(mapping)
+    expected = df.with_columns(nw.col(k).cast(v) for k, v in mapping.items())
+    assert result.collect_schema() == expected.collect_schema()
+    assert result.collect_schema().names() == ["a", "b", "c"]
+    assert_equal_data(result, {"a": [1.0, 2.0], "b": [3, 4], "c": [0.5, 1.5]})
+
+
+def test_cast_empty_mapping(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": [3.0, 4.0]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({})
+    assert result.collect_schema() == df.collect_schema()
+    assert_equal_data(result, data)
+
+
+def test_cast_accepts_dtype_class(constructor: Constructor) -> None:
+    data = {"a": ["2020-01-01T00:00:00"]}
+    df = nw.from_native(constructor(data)).with_columns(
+        nw.col("a").str.to_datetime(format="%Y-%m-%dT%H:%M:%S")
+    )
+    result = df.cast({"a": nw.Datetime})
+    expected = df.with_columns(nw.col("a").cast(nw.Datetime))
+    assert result.collect_schema() == expected.collect_schema()
+
+
+def test_cast_column_not_found(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(ColumnNotFoundError, match="zz"):
+        df.cast({"zz": nw.Int64})
+
+
+@pytest.mark.parametrize("dtype", ["int64", None])
+def test_cast_rejects_non_narwhals_dtype(
+    constructor: Constructor, dtype: IntoDType
+) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": dtype})  # type: ignore[dict-item]
+
+
+def test_cast_backend_failure_raises_narwhals_error(
+    request: pytest.FixtureRequest, constructor: Constructor
+) -> None:
+    if any(name in str(constructor) for name in ("duckdb", "sqlframe", "dask")):
+        # These backends only run the cast at `collect`, and their native errors are
+        # not yet mapped to NarwhalsError there.
+        request.applymarker(pytest.mark.xfail)
+    df = nw.from_native(constructor({"a": ["x", "y"]}))
+
+    def cast_and_materialize() -> None:
+        result = df.cast({"a": nw.Int64})
+        if isinstance(result, nw.LazyFrame):
+            result.collect()
+
+    with pytest.raises(NarwhalsError):
+        cast_and_materialize()
+
+
+def test_cast_pyarrow_keeps_schema_metadata_and_field_details() -> None:
+    schema = pa.schema(
+        [
+            pa.field("a", pa.int64(), nullable=True),
+            pa.field("b", pa.int64(), nullable=False, metadata={"k": "v"}),
+            pa.field("c", pa.string(), nullable=False),
+        ],
+        metadata={"table": "meta"},
+    )
+    native = pa.table({"a": [1, None], "b": [2, 3], "c": ["x", None]}, schema=schema)
+    result = nw.from_native(native).cast({"a": nw.Float64}).to_native()
+
+    assert result.schema.metadata == {b"table": b"meta"}
+    assert result.schema.field("a").type == pa.float64()
+    assert result.schema.field("a").nullable is True
+    assert result.schema.field("b") == schema.field("b")
+    assert result.schema.field("c") == schema.field("c")
+
+
+def test_cast_pyarrow_keeps_nullability_of_cast_column() -> None:
+    schema = pa.schema([pa.field("a", pa.int64(), nullable=False)])
+    native = pa.table({"a": [1, 2]}, schema=schema)
+    result = nw.from_native(native).cast({"a": nw.Float64}).to_native()
+    assert result.schema.field("a") == pa.field("a", pa.float64(), nullable=False)
+
+
+def test_cast_pyarrow_ignores_non_nullable_null_in_uncast_column() -> None:
+    schema = pa.schema(
+        [pa.field("a", pa.int64()), pa.field("b", pa.int64(), nullable=False)]
+    )
+    native = pa.table({"a": [1, 2], "b": [None, 4]}, schema=schema)
+    result = nw.from_native(native).cast({"a": nw.Float64}).to_native()
+    assert result.schema.field("b") == schema.field("b")
+    assert result.column("a").to_pylist() == [1.0, 2.0]
