@@ -469,6 +469,21 @@ class ArrowDataFrame(
         to_drop = parse_columns_to_drop(self, columns, strict=strict)
         return self._with_native(self.native.drop(to_drop), validate_column_names=False)
 
+    def cast(self, dtypes: Mapping[str, IntoDType]) -> Self:
+        # Going through `with_columns` would rebuild each field as nullable, which
+        # would drop the nullability of a non-nullable column being cast.
+        native = self.native
+        for name, dtype in dtypes.items():
+            index = native.schema.get_field_index(name)
+            field = native.schema.field(index)
+            target = narwhals_to_native_dtype(dtype, self._version)
+            column = native.column(index).cast(target)
+            new_field = pa.field(
+                name, target, nullable=field.nullable, metadata=field.metadata
+            )
+            native = native.set_column(index, new_field, column)
+        return self._with_native(native, validate_column_names=False)
+
     def drop_nulls(self, subset: Sequence[str] | None) -> Self:
         if subset is None:
             return self._with_native(self.native.drop_null(), validate_column_names=False)
