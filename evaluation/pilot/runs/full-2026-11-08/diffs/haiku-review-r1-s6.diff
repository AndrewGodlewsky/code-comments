+def _comparison_group(dtype: pa.DataType) -> str | None:
+    """Return the family of `dtype` for `pc.equal`, or `None` if it isn't checked.
+
+    Types in different families can't be compared, types in one family can.
+    Timestamps are split by unit and by timezone-awareness, as `pc.equal` raises
+    for naive vs aware, but not for different zones.
+    """
+    if pa.types.is_boolean(dtype):
+        return "bool"
+    if (
+        pa.types.is_integer(dtype)
+        or pa.types.is_floating(dtype)
+        or pa.types.is_decimal(dtype)
+    ):
+        return "number"
+    if pa.types.is_string(dtype) or pa.types.is_large_string(dtype):
+        return "string"
+    if pa.types.is_timestamp(dtype):
+        aware = "aware" if dtype.tz is not None else "naive"
+        return f"timestamp[{dtype.unit}, {aware}]"
+    return None
+
+
+def raise_if_incomparable_item(list_type: pa.DataType, item: Any) -> None:
+    """Raise if `item` can't be compared with the items of a `list_type` array.
+
+    Depends only on the type, so it also applies to empty arrays and to dask metadata.
+    """
+    inner = cast("pa.ListType", list_type).value_type
+    if item is None or pa.types.is_null(inner):
+        return
+    item_type = lit(item).type
+    inner_group, item_group = _comparison_group(inner), _comparison_group(item_type)
+    if inner_group is None or item_group is None or inner_group == item_group:
+        return
+    msg = f"`list.contains` cannot check for {inner} values in {item_type} data"
+    raise InvalidOperationError(msg)
+
+
 def list_contains(array: ChunkedArrayAny, item: Any) -> ChunkedArrayAny:
+    raise_if_incomparable_item(array.type, item)
     flat = pc.list_flatten(array)
-    matches = pc.is_null(flat) if item is None else pc.equal(flat, lit(item))
+    if item is None:
+        matches = pc.is_null(flat)
+    elif pa.types.is_null(cast("pa.ListType", array.type).value_type):
+        # `pc.equal` has no kernel for the null type. Every item is null, so `is_valid`
+        # is False throughout and `_aggregate_per_list` reports no match.
+        matches = pc.is_valid(flat)
+    else:
+        matches = pc.equal(flat, lit(item))
     return _aggregate_per_list(
         array,
         matches,
