@@ -527,13 +527,33 @@ def concat_tables(
 class ArrowSeriesNamespace(EagerSeriesNamespace["ArrowSeries", "ChunkedArrayAny"]): ...
 
 
+def _equal_or_raise(flat: Any, item: Any) -> Any:
+    from datetime import datetime
+
+    from narwhals.exceptions import InvalidOperationError
+
+    dtype = flat.type
+    if (
+        isinstance(item, datetime)
+        and pa.types.is_timestamp(dtype)
+        and dtype.unit != "us"
+    ):
+        msg = f"cannot compare a datetime item with list items of type {dtype}."
+        raise InvalidOperationError(msg)
+    try:
+        return pc.equal(flat, lit(item))
+    except (pa.ArrowNotImplementedError, pa.ArrowInvalid, pa.ArrowTypeError) as exc:
+        msg = f"cannot check whether lists of {dtype} contain item {item!r}: {exc}"
+        raise InvalidOperationError(msg) from exc
+
+
 def list_contains(array: ChunkedArrayAny, item: Any) -> ChunkedArrayAny:
     arr = array.combine_chunks()
     flat = pc.list_flatten(arr)
     if item is None:
         matches = pc.is_null(flat)
     else:
-        matches = pc.fill_null(pc.equal(flat, lit(item)), False)  # noqa: FBT003
+        matches = pc.fill_null(_equal_or_raise(flat, item), False)  # noqa: FBT003
     hits = pc.filter(pc.list_parent_indices(arr), matches)
     found = pc.is_in(pa.array(range(len(arr)), type=hits.type), value_set=hits)
     result = pc.if_else(pc.is_valid(arr), found, lit(None, type=pa.bool_()))
