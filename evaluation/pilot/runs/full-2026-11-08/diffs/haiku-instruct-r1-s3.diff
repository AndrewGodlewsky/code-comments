+    def cast(self, dtypes: Mapping[str, IntoDType]) -> Self:
+        # Replace only the cast columns, keeping their fields: `with_columns` would reset
+        # nullability and field metadata, and `Table.cast` would reject nulls in
+        # non-nullable columns that aren't being cast.
+        plx = self.__narwhals_namespace__()
+        native = self.native
+        for name, dtype in dtypes.items():
+            (series,) = self._evaluate_exprs(plx.col(name).cast(dtype))
+            index = native.schema.get_field_index(name)
+            field = native.schema.field(index)
+            new_field = pa.field(
+                name, series.native.type, nullable=field.nullable, metadata=field.metadata
+            )
+            native = native.set_column(index, new_field, series.native)
+        return self._with_native(native, validate_column_names=False)
