diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..264f64c
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,85 @@
+from __future__ import annotations
+
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError, NarwhalsError
+from tests.utils import Constructor, assert_equal_data
+
+
+def test_cast(constructor: Constructor) -> None:
+    data = {"a": [1, 3, 2], "b": [4, 4, 6], "c": ["x", "y", "z"]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({"a": nw.Float64, "b": nw.Int32()})
+    expected = {"a": [1.0, 3.0, 2.0], "b": [4, 4, 6], "c": ["x", "y", "z"]}
+    assert_equal_data(result, expected)
+    assert result.collect_schema().names() == ["a", "b", "c"]
+    assert result.collect_schema()["a"] == nw.Float64
+    assert result.collect_schema()["b"] == nw.Int32
+    assert result.collect_schema()["c"] == df.collect_schema()["c"]
+
+
+def test_cast_matches_with_columns(constructor: Constructor) -> None:
+    data = {"a": [1, 3, 2], "b": [4, 4, 6], "c": ["x", "y", "z"]}
+    df = nw.from_native(constructor(data))
+    mapping = {"a": nw.Float64, "b": nw.Int32}
+    result = df.cast(mapping)
+    expected = df.with_columns(nw.col(k).cast(v) for k, v in mapping.items())
+    assert result.collect_schema() == expected.collect_schema()
+
+
+def test_cast_empty_mapping(constructor: Constructor) -> None:
+    data = {"a": [1, 3, 2], "b": [4, 4, 6]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({})
+    assert_equal_data(result, data)
+    assert result.collect_schema() == df.collect_schema()
+
+
+def test_cast_dtype_class(constructor: Constructor) -> None:
+    data = {"a": [1, 3, 2], "b": ["x", "y", "z"]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({"a": nw.String})
+    assert result.collect_schema()["a"] == nw.String
+    assert_equal_data(result, {"a": ["1", "3", "2"], "b": ["x", "y", "z"]})
+
+
+def test_cast_column_not_found(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2], "b": [3, 4]}))
+    with pytest.raises(ColumnNotFoundError):
+        df.cast({"z": nw.Float64})
+
+
+def test_cast_invalid_dtype(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": "int64"})  # type: ignore[dict-item]
+
+
+def test_cast_unsupported(constructor: Constructor) -> None:
+    if "polars" not in str(constructor):
+        pytest.skip("Only Polars wraps native cast errors in a Narwhals exception")
+    df = nw.from_native(constructor({"a": ["1", "x"]}))
+    with pytest.raises(NarwhalsError):
+        df.cast({"a": nw.Int64}).collect()
+
+
+def test_cast_pyarrow_preserves_schema() -> None:
+    pa = pytest.importorskip("pyarrow")
+    schema = pa.schema(
+        [
+            pa.field("a", pa.int64(), nullable=False, metadata={"k": "v"}),
+            pa.field("b", pa.int64(), nullable=False),
+            pa.field("c", pa.string(), nullable=False),
+        ],
+        metadata={"sm": "1"},
+    )
+    native = pa.table({"a": [1, 2], "b": [3, None], "c": ["x", "y"]}, schema=schema)
+    result = nw.from_native(native).cast({"a": nw.Float64, "c": nw.String}).to_native()
+    assert result.schema.metadata == {b"sm": b"1"}
+    assert result.schema.field("a") == pa.field(
+        "a", pa.float64(), nullable=False, metadata={"k": "v"}
+    )
+    assert result.schema.field("b") == schema.field("b")
+    assert result.schema.field("c") == pa.field("c", pa.string(), nullable=False)
+    assert result.column("b").to_pylist() == [3, None]
