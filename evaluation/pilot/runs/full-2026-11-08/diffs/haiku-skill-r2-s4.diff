     return (value,) * n_match if isinstance(value, bool) else tuple(value)
 
 
+def normalize_bool_flags(
+    value: bool | Sequence[bool], n_match: int, name: str
+) -> bool | Sequence[bool]:
+    """Validate a `descending`/`reverse` argument with Polars' errors, whatever the backend."""
+    if isinstance(value, bool):
+        return value
+    n_flags = len(value)
+    if n_flags != n_match:
+        msg = (
+            f"the length of `{name}` ({n_flags}) does not match "
+            f"the length of `by` ({n_match})"
+        )
+        raise ValueError(msg)
+    flags = tuple(value)
+    np = get_numpy()
+    bool_types = (bool,) if np is None else (bool, np.bool_)
+    for flag in flags:
+        if not isinstance(flag, bool_types):
+            msg = (
+                f"'{type(flag).__name__}' object is not an instance of 'bool' "
+                f"while processing '{name}'"
+            )
+            raise TypeError(msg)
+    return flags
+
+
