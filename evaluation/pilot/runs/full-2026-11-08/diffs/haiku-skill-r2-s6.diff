+def _is_whole(item: NonNestedLiteral) -> bool:
+    if isinstance(item, Decimal):
+        return item.is_finite() and item == item.to_integral_value()
+    if isinstance(item, float):
+        return item.is_integer()
+    return True
+
+
+def list_contains_item(inner: pa.DataType, item: NonNestedLiteral) -> pa.Scalar | None:
+    # `None` means no element can equal `item`, so non-null lists give `False`.
+    if pa.types.is_null(inner):
+        return None
+    if isinstance(item, bool):
+        compatible = pa.types.is_boolean(inner)
+    elif isinstance(item, datetime):
+        # pandas Timestamps carry their unit. `pa.scalar` would silently truncate a
+        # finer one.
+        compatible = is_timestamp(inner) and inner.unit == getattr(item, "unit", "us")
+    elif isinstance(item, date):
+        compatible = pa.types.is_date(inner)
+    elif isinstance(item, str):
+        compatible = pa.types.is_string(inner) or pa.types.is_large_string(inner)
+    elif isinstance(item, bytes):
+        compatible = pa.types.is_binary(inner) or pa.types.is_large_binary(inner)
+    elif isinstance(item, time):
+        compatible = pa.types.is_time(inner)
+    elif isinstance(item, timedelta):
+        compatible = is_duration(inner)
+    else:
+        compatible = (
+            pa.types.is_integer(inner)
+            or pa.types.is_floating(inner)
+            or pa.types.is_decimal(inner)
+        )
+    msg = f"`list.contains` cannot check for {type(item).__name__} values in {inner}."
+    if not compatible:
+        raise InvalidOperationError(msg)
+    # `pa.scalar` would truncate `1.5` to `1` for an integer type.
+    if pa.types.is_integer(inner) and not _is_whole(item):
+        return None
+    try:
+        return pa.scalar(item, type=inner)
+    except (pa.ArrowInvalid, pa.ArrowTypeError, pa.ArrowNotImplementedError) as exc:
+        raise InvalidOperationError(msg) from exc
+
