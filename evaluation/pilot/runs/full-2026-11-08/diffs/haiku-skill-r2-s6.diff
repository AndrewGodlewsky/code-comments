+def test_contains_incompatible_item_raises(
+    request: pytest.FixtureRequest,
+    constructor: Constructor,
+    values: list[Any],
+    dtype: DType,
+    item: Any,
+    empty: bool,
+) -> None:
+    skip_or_xfail_unsupported(request, constructor)
+    if any(backend in str(constructor) for backend in ("duckdb", "sqlframe")):
+        pytest.skip(reason="item type checks are only implemented for pyarrow and Polars")
+    df = nw.from_native(constructor({"i": [0], "a": [values]}))
