+def test_contains_numeric_item_coercion(
+    request: pytest.FixtureRequest, constructor: Constructor
+) -> None:
+    skip_or_xfail_unsupported(request, constructor)
+    df = nw.from_native(constructor({"a": [[1, 2], [3], None]}))
+    int_list = df.select(nw.col("a").cast(nw.List(nw.Int64())))
+    result = int_list.select(
+        two=nw.col("a").list.contains(2.0), half=nw.col("a").list.contains(1.5)
+    )
+    expected = {"two": [True, False, None], "half": [False, False, None]}
+    assert_equal_data(result, expected)
+    float_list = df.select(nw.col("a").cast(nw.List(nw.Float64())))
+    result = float_list.select(nw.col("a").list.contains(1))
+    assert_equal_data(result, {"a": [True, False, None]})
