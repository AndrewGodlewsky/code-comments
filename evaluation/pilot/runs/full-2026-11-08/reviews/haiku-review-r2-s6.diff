+def test_contains_incompatible_item_raises(
+    request: pytest.FixtureRequest, constructor: Constructor, inner: DType, item: Any
+) -> None:
+    skip_or_xfail_unsupported(request, constructor)
+    if any(backend in str(constructor) for backend in ("duckdb", "sqlframe")):
+        pytest.skip(reason="Only pyarrow-backed backends are checked against the item")
+    df = nw.from_native(constructor({"a": [[], None]})).select(
+        nw.col("a").cast(nw.List(inner))
+    )
+    expr = nw.col("a").list.contains(item)
+    with pytest.raises(InvalidOperationError, match="list.contains"):
+        df.select(expr).lazy().collect()
+    with pytest.raises(InvalidOperationError, match="list.contains"):
+        df.head(0).select(expr).lazy().collect()
