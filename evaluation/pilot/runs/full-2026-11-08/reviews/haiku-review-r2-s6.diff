+def validate_list_contains_item(value_type: pa.DataType, item: NonNestedLiteral) -> None:
+    # Checked on types, not values, so that it also fires for zero-row inputs.
+    if item is None:
+        return
+    item_type = pa.scalar(item).type
+    try:
+        pc.equal(pa.array([], type=value_type), pa.scalar(item))
+    except pa.ArrowException:
+        incompatible = True
+    else:
+        # pyarrow silently casts between datetime units and between dates and
+        # timestamps, whereas Polars rejects these.
+        is_timestamp_item = pa.types.is_timestamp(item_type)
+        incompatible = (
+            pa.types.is_timestamp(value_type)
+            and (
+                pa.types.is_date(item_type)
+                or (is_timestamp_item and item_type.unit != value_type.unit)
+            )
+        ) or (pa.types.is_date(value_type) and is_timestamp_item)
+    if incompatible:
+        msg = f"`list.contains` cannot check for {value_type} values in {item_type} data"
+        raise InvalidOperationError(msg)
+
+
 def list_contains(array: ChunkedArrayAny, item: NonNestedLiteral) -> ChunkedArrayAny:
+    validate_list_contains_item(array.type.value_type, item)
     # Linear in the number of list elements: compare the flattened values once, then
