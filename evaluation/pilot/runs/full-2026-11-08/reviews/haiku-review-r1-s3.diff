diff --git a/tests/frame/cast_test.py b/tests/frame/cast_test.py
new file mode 100644
index 0000000..b23da85
--- /dev/null
+++ b/tests/frame/cast_test.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+
+from datetime import datetime
+from typing import TYPE_CHECKING
+
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import ColumnNotFoundError, NarwhalsError
+from tests.utils import assert_equal_data
+
+if TYPE_CHECKING:
+    from tests.utils import Constructor
+
+
+def test_cast(constructor: Constructor) -> None:
+    data = {"a": [1, 2, 3], "b": [4.0, 5.0, 6.0], "c": ["x", "y", "z"]}
+    df = nw.from_native(constructor(data))
+    mapping = {"a": nw.Float64, "b": nw.Int32}
+    result = df.cast(mapping)
+    expected = df.with_columns(nw.col(k).cast(v) for k, v in mapping.items())
+    assert result.collect_schema() == expected.collect_schema()
+    assert result.collect_schema().names() == ["a", "b", "c"]
+    expected_data = {"a": [1.0, 2.0, 3.0], "b": [4, 5, 6], "c": ["x", "y", "z"]}
+    assert_equal_data(result, expected_data)
+
+
+def test_cast_dtype_class(constructor: Constructor) -> None:
+    data = {"a": [datetime(2020, 1, 1)], "b": [1]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({"a": nw.Datetime, "b": nw.Int32})
+    expected = df.with_columns(
+        nw.col("a").cast(nw.Datetime), nw.col("b").cast(nw.Int32)
+    )
+    assert result.collect_schema() == expected.collect_schema()
+    assert_equal_data(result, {"a": [datetime(2020, 1, 1)], "b": [1]})
+
+
+def test_cast_empty_mapping(constructor: Constructor) -> None:
+    data = {"a": [1, 2], "b": ["x", "y"]}
+    df = nw.from_native(constructor(data))
+    result = df.cast({})
+    assert result.collect_schema() == df.collect_schema()
+    assert_equal_data(result, data)
+
+
+def test_cast_missing_column(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(ColumnNotFoundError):
+        df.cast({"z": nw.Int64})
+
+
+def test_cast_invalid_dtype(constructor: Constructor) -> None:
+    df = nw.from_native(constructor({"a": [1, 2]}))
+    with pytest.raises(TypeError, match="Expected Narwhals dtype"):
+        df.cast({"a": "int64"})  # type: ignore[dict-item]
+
+
+def test_cast_unsupported_raises(constructor: Constructor) -> None:
+    if "polars" not in str(constructor):
+        pytest.skip("only checked for polars")
+    df = nw.from_native(constructor({"s": ["abc"]}))
+    with pytest.raises(NarwhalsError):
+        df.cast({"s": nw.Int64}).lazy().collect()
+
+
+def test_cast_pyarrow_keeps_schema_details() -> None:
+    pa = pytest.importorskip("pyarrow")
+    schema = pa.schema(
+        [
+            pa.field("a", pa.int64(), nullable=False, metadata={"k": "v"}),
+            pa.field("b", pa.int64()),
+            pa.field("c", pa.string(), nullable=False),
+        ],
+        metadata={"table": "meta"},
+    )
+    data = {"a": [1, 2], "b": [3, None], "c": ["x", "y"]}
+    table = pa.Table.from_pydict(data, schema=schema)
+    result = nw.from_native(table).cast({"b": nw.Float64, "c": nw.String}).to_native()
+    assert result.schema.metadata == {b"table": b"meta"}
+    assert result.schema.field("a") == schema.field("a")
+    assert result.schema.field("b") == pa.field("b", pa.float64())
+    assert result.schema.field("c") == schema.field("c")
+    assert result.column("b").to_pylist() == [3.0, None]
+
+
+def test_cast_pyarrow_ignores_non_nullable_uncast_column_with_nulls() -> None:
+    pa = pytest.importorskip("pyarrow")
+    schema = pa.schema(
+        [pa.field("a", pa.int64(), nullable=False), pa.field("b", pa.int64())]
+    )
+    table = pa.Table.from_pydict({"a": [1, None], "b": [3, 4]}, schema=schema)
+    result = nw.from_native(table).cast({"b": nw.Float64}).to_native()
+    assert result.column("a").to_pylist() == [1, None]
+    assert result.schema.field("b") == pa.field("b", pa.float64())
