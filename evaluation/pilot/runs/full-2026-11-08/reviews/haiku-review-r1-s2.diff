@@ -563,6 +563,33 @@ def list_agg(
     )
 
 
+def list_contains(array: ChunkedArrayAny, item: Any) -> ChunkedArrayAny:
+    # One row per element, then one `any` per list: linear in the number of elements.
+    flat = pc.list_flatten(array)
+    matches = pc.is_null(flat) if item is None else pc.equal(flat, lit(item))
+    any_opts = pc.ScalarAggregateOptions(skip_nulls=True, min_count=0)
+    found = (
+        pa.Table.from_arrays(
+            [pc.list_parent_indices(array), matches], names=["offsets", "matches"]
+        )
+        .group_by("offsets")
+        .aggregate([("matches", "any", any_opts)])
+        .sort_by("offsets")
+        .column("matches_any")
+        .combine_chunks()
+    )
+    array_ = array.combine_chunks()
+    non_empty_mask = pc.greater(pc.list_value_length(array_), lit(0))
+    result = pc.replace_with_mask(
+        pa.repeat(lit(False), len(array)),
+        cast("pa.BooleanArray", non_empty_mask.fill_null(False)),
+        found,
+    )
+    return pa.chunked_array(
+        [pc.if_else(pc.is_null(array_), lit(None, type=pa.bool_()), result)]
+    )
+
+
