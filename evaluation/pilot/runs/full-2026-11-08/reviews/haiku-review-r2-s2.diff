new file mode 100644
index 0000000..ae61c7c
--- /dev/null
+++ b/src/narwhals/_dask/expr_list.py
@@ -0,0 +1,60 @@
+from __future__ import annotations
+
+from functools import partial
+from typing import TYPE_CHECKING
+
+import pandas as pd
+
+from narwhals._compliant import LazyExprNamespace
+from narwhals._compliant.any_namespace import ListNamespace
+from narwhals._pandas_like.utils import is_dtype_pyarrow
+from narwhals._utils import not_implemented
+
+if TYPE_CHECKING:
+    import dask.dataframe.dask_expr as dx
+
+    from narwhals._dask.expr import DaskExpr
+    from narwhals.typing import NonNestedLiteral
+
+
+def _list_contains_partition(series: pd.Series, *, item: NonNestedLiteral) -> pd.Series:
+    import pyarrow as pa  # ignore-banned-import
+
+    from narwhals._arrow.utils import list_contains
+
+    result = list_contains(series.array._pa_array, item)  # type: ignore[attr-defined]
+    return pd.Series(
+        result,
+        index=series.index,
+        name=series.name,
+        dtype=pd.ArrowDtype(pa.bool_()),
+    )
+
+
+class DaskExprListNamespace(LazyExprNamespace["DaskExpr"], ListNamespace["DaskExpr"]):
+    def contains(self, item: NonNestedLiteral) -> DaskExpr:
+        def func(expr: dx.Series) -> dx.Series:
+            if not is_dtype_pyarrow(expr.dtype):  # pragma: no cover
+                msg = (
+                    "dask backed `Expr.list.contains` only supports "
+                    "pyarrow-backed list columns."
+                )
+                raise NotImplementedError(msg)
+            import pyarrow as pa  # ignore-banned-import
+
+            return expr.map_partitions(
+                partial(_list_contains_partition, item=item),
+                meta=(expr.name, pd.ArrowDtype(pa.bool_())),
+            )
+
+        return self.compliant._with_callable(func)
+
+    len = not_implemented()
+    unique = not_implemented()
+    get = not_implemented()
+    min = not_implemented()
+    max = not_implemented()
+    mean = not_implemented()
+    median = not_implemented()
+    sum = not_implemented()
+    sort = not_implemented()
