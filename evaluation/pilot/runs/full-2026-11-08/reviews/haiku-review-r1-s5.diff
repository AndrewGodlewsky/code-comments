+def _list_len(array: Any) -> Any:
+    import pyarrow as pa
+    import pyarrow.compute as pc
+
+    # Matches the `UInt32` result of the pandas-like backends.
+    return pc.cast(pc.list_value_length(array), pa.uint32())
+
+
+def _list_get(index: int) -> Callable[[Any], Any]:
+    import pyarrow.compute as pc
+
+    return lambda array: pc.list_element(array, index)
+
+
+def _raise_if_not_pyarrow_list(native: dx.Series) -> None:
+    from narwhals._arrow.utils import is_list
+    from narwhals._pandas_like.utils import is_dtype_pyarrow
+
+    if not (is_dtype_pyarrow(native.dtype) and is_list(native.dtype.pyarrow_dtype)):
+        msg = "Only pyarrow-backed list columns are currently supported on dask."
+        raise NotImplementedError(msg)
 
 
 class DaskExprListNamespace(LazyExprNamespace["DaskExpr"], ListNamespace["DaskExpr"]):
-    def contains(self, item: NonNestedLiteral) -> DaskExpr:
