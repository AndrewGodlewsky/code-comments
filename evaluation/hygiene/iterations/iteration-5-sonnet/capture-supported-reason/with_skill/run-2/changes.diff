 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    """Write the cleaned rows to sink in ascending customer_id order."""
+    # The warehouse loader merge-joins each batch against the previous snapshot on
+    # customer_id in a single pass, so it assumes the batch is sorted by customer_id
+    # and silently skips rows that arrive out of order (DATA-412). The loader is in
+    # another repository, so the ordering is guaranteed here. Sort the cleaned rows:
+    # clean() trims the id, and the loader sees the trimmed value.
+    for row in sorted(map(clean, rows), key=lambda r: r["customer_id"]):
+        sink.write(row)
