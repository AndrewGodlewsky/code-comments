 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    """Write the cleaned rows to sink in ascending customer_id order."""
+    # The warehouse loader merge-joins each batch against the previous snapshot
+    # in a single pass, so it assumes the batch is sorted by customer_id and
+    # silently skips rows that arrive out of order. Sort the cleaned ids (the
+    # values the loader sees), not the raw ones. The loader is in another
+    # repository, so the ordering has to be guaranteed here (DATA-412).
+    for row in sorted(map(clean, rows), key=lambda r: r["customer_id"]):
+        sink.write(row)
