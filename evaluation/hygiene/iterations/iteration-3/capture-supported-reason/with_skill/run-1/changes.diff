--- a/pipeline/stage.py
+++ b/pipeline/stage.py
@@ -7,5 +7,10 @@
 
 
 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    # The warehouse loader merge-joins each batch against the previous snapshot in
+    # a single pass and silently skips rows that arrive out of order, so a batch
+    # must be written sorted by customer_id. Sort on the cleaned id (the trimmed
+    # value clean() produces), since that is what the loader compares.
+    cleaned = [clean(row) for row in rows]
+    for row in sorted(cleaned, key=lambda r: r["customer_id"]):
+        sink.write(row)
