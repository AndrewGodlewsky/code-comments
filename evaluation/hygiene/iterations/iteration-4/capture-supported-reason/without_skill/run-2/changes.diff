--- a/pipeline/stage.py
+++ b/pipeline/stage.py
@@ -7,5 +7,13 @@
 
 
 def write_batch(rows, sink):
-    for row in rows:
-        sink.write(clean(row))
+    """Write cleaned rows sorted by customer_id.
+
+    The warehouse loader merge-joins each batch against the previous snapshot
+    in a single pass and silently skips rows that arrive out of order, so the
+    batch must be sorted by the same (cleaned) customer_id it compares on.
+    """
+    cleaned = [clean(row) for row in rows]
+    cleaned.sort(key=lambda row: row["customer_id"])
+    for row in cleaned:
+        sink.write(row)
